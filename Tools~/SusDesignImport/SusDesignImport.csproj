<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SusDesignImport</RootNamespace>
    <AssemblyName>SusDesignImport</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>CS0649;CS0169;CS8618;IDE1006</NoWarn>
    <DefineConstants>SUS_DESIGN_IMPORT_CLI</DefineConstants>
  </PropertyGroup>

  <!-- Shared library lives under Editor/DesignImport (Unity EditMode); CLI links the same sources. -->
  <ItemGroup>
    <Compile Include="..\..\Editor\DesignImport\*.cs" Link="Lib\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="alias-map.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" LinkBase="Fixtures" />
  </ItemGroup>

</Project>
