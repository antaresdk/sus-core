#!/bin/sh
# sus-pre-push v1 — package push gate: docs consistency (package scope) + HARD version bump.
#
# Canonical instance lives in the umbrella tooling folder; the versioned copy inside each package
# is `<pkg>/scripts~/pre-push` and is BYTE-IDENTICAL to it. Install/compare from the umbrella:
#   node tools/docs-tool/index.mjs ...   (see the umbrella docs; `hooks --install` writes both)
#
# Wording note: this file is tracked in the PUBLIC packages, so it stays inside the public
# vocabulary (see rule R25) and calls the neutral shim `tools/docs-tool` — the shim exists exactly
# for this, and the umbrella entry point must not be named here.
#
# No machine paths on purpose: the umbrella is derived from the repo root (packages sit next to
# it). The former wrapper baked an absolute `C:\...` path in, so the gate survived a folder move
# on exactly one machine and silently did nothing anywhere else.
set -e

TOP="$(git rev-parse --show-toplevel)"
UMBRELLA="$(cd "$TOP/.." && pwd)"
PKG="$(basename "$TOP")"

# ── 1. docs gate for THIS package ────────────────────────────────────────────────────────
# `verify --scope <pkg>` judges FILES OF THIS PACKAGE: an unrelated wave in the umbrella does not
# block the push, and is not silenced either — it is printed as a count with its own route.
# No umbrella next to the package (standalone clone) — the step is skipped, loudly.
# git feeds the ref list on stdin ONCE - read it whole, otherwise a chained `.local` hook would
# get an empty stream and stay silent instead of checking anything.
REFS="$(cat)"

DOCS_TOOL="$UMBRELLA/tools/docs-tool/index.mjs"
if [ -f "$DOCS_TOOL" ]; then
    # R47 (T-691): reject push of commits with AI trailers / AI author|committer emails.
    # Runs BEFORE docs verify so a lone attribution hit is named without a wall of foreign findings.
    printf '%s\n' "$REFS" | while read local_ref local_sha remote_ref remote_sha; do
        [ -n "$local_sha" ] || continue
        if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
            continue
        fi
        if ! node "$DOCS_TOOL" attribution --cwd "$TOP" --local "$local_sha" --remote "$remote_sha"; then
            echo "[pre-push] R47 attribution-guard failed — strip AI trailers/emails, then retry" >&2
            exit 1
        fi
    done || exit 1

    if ! node "$DOCS_TOOL" verify --scope "$PKG"; then
        echo "[pre-push] docs verify failed for $PKG - fix findings inside the package and retry" >&2
        echo "[pre-push] umbrella-wide findings are NOT this gate: run 'npm run docs:loop' there" >&2
        exit 1
    fi
else
    echo "[pre-push] docs gate skipped (no umbrella tooling next to $PKG)" >&2
fi

# ── 2. HARD version bump ─────────────────────────────────────────────────────────────────
# Any source change (.cs except *.g.cs, .sharq, .asmdef) must raise package.json STRICTLY above
# the remote version. The baseline comes from the refs git feeds the hook on stdin, so the check
# does not depend on what the remote is called (origin / gitea / anything else).
# Strict X.Y.Z (or fewer parts) compare. Do NOT use `sort -V`: on Git-for-Windows the first
# `sort` on PATH is often `C:\Windows\system32\sort.exe`, which has no -V and leaves top empty —
# then a real bump (1.0.0→1.0.1) is rejected as "not bumped" (caught by plant-prepush A3).
version_gt() {
    a=$(printf '%s' "$1" | tr -d '\r')
    b=$(printf '%s' "$2" | tr -d '\r')
    [ -n "$a" ] && [ -n "$b" ] || return 1
    [ "$a" != "$b" ] || return 1
    oldIFS=$IFS
    IFS=.
    # shellcheck disable=SC2086
    set -- $a
    a1=${1:-0} a2=${2:-0} a3=${3:-0}
    # shellcheck disable=SC2086
    set -- $b
    b1=${1:-0} b2=${2:-0} b3=${3:-0}
    IFS=$oldIFS
    [ "$a1" -gt "$b1" ] && return 0
    [ "$a1" -lt "$b1" ] && return 1
    [ "$a2" -gt "$b2" ] && return 0
    [ "$a2" -lt "$b2" ] && return 1
    [ "$a3" -gt "$b3" ]
}

# The pipe spawns a subshell, so `exit 1` inside `while` would only kill that subshell: without
# the trailing `|| exit 1` a rejected version would turn into a green push.
printf '%s\n' "$REFS" | while read local_ref local_sha remote_ref remote_sha; do
    [ -n "$local_sha" ] || continue
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    changed=$(git diff --name-only "$remote_sha..$local_sha" -- '*.cs' '*.sharq' '*.asmdef' \
        | grep -v '\.g\.cs$' || true)
    if [ -z "$changed" ]; then
        continue
    fi

    old_version=$(git show "$remote_sha:package.json" | grep '"version"' | head -1 | sed 's/.*"\([^"]*\)".*/\1/')
    new_version=$(git show "$local_sha:package.json"  | grep '"version"' | head -1 | sed 's/.*"\([^"]*\)".*/\1/')

    if ! version_gt "$new_version" "$old_version"; then
        echo ""
        echo "=========================================="
        echo "  PUSH REJECTED: version not bumped"
        echo "=========================================="
        echo ""
        echo "Source changed, but package.json version is not strictly greater."
        echo "  remote: $old_version"
        echo "  local:  $new_version"
        echo ""
        echo "Changed:"
        echo "$changed" | sed 's/^/  /'
        echo ""
        echo "Fix:"
        echo "  Edit package.json: bump version (ex: $old_version -> next patch/minor)"
        echo "  git add package.json && git commit -m 'release: bump'"
        echo "  git push"
        echo ""
        exit 1
    fi

    echo "[pre-push] Version check OK: $old_version -> $new_version"
done || exit 1

# A pre-existing repo hook (not ours) is kept and called in a chain, like pre-commit/commit-msg.
PREV="$(dirname "$0")/pre-push.local"
if [ -f "$PREV" ]; then
    printf '%s\n' "$REFS" | sh "$PREV" "$@" || exit $?   # sh, not the exec bit: file modes are unreliable on Windows
fi
exit 0
