/* ── SUS Font Family Definitions ──────────────────────────
   Auto-loaded by SusBootstrap.LoadTokenCascade() (after _palette).

   Each var(--font-family-*) resolves from --sus-font-family-* first,
   falling back to the packaged Montserrat.

   T-2767 (D-069 / R120): the typeface of every role is declared HERE, in USS.
   No C# writes -unity-font-definition as an inline style any more — an inline
   value outranks every USS rule regardless of specificity, so the buyer could
   not restyle what SusFontService had written. SusFontService now only
   adds/removes the marker USS classes below; the VALUE always comes from the
   --sus-font-family-* / --font-family-* token chain, which any theme, skin or
   project override sheet can redefine.

   How to change the typeface:
     • Per-weight, token-level (all families incl. italic/black/condensed):
       place Assets/Resources/SusRuntime/_font.uss in your project and set
       --sus-font-family-* there. A skin does the same from its own brand
       sheet. A SusFontAsset filled in the Inspector is turned into exactly
       such a sheet by  SUS > Fonts > Export Font Set to USS
       (SusFontUssExporter) — that is the supported way to bring a project's
       own typefaces in, and it replaces the old inline-style code path.
     • Per-role, markup-level: tag an element with the matching
       SusFontService.<Role>ClassName marker class (see the rules below) —
       no C# call needed, the class alone carries the role's typeface.
   ──────────────────────────────────────────────────────────── */

/* ── Typographic Scale (base sizes) ────────────────────────── */
:root {
    --base-font-size-xs:   10px;
    --base-font-size-sm:   12px;
    --base-font-size-md:   14px;
    --base-font-size-lg:   16px;
    --base-font-size-xl:   20px;
    --base-font-size-2xl:  24px;
    --base-font-size-3xl:  32px;
    --base-font-size-4xl:  48px;

    /* Letter-spacing (px only in USS) */
    --base-font-tracking-tight:  -0.15px;
    --base-font-tracking-normal:  0px;
    --base-font-tracking-wide:    0.15px;
}

/* ── Font Families (Montserrat default, overridable via --sus-font-family-*) ── */
:root {
    --font-family-regular:   var(--sus-font-family-regular,   url("Fonts/Montserrat/Montserrat-Regular.ttf"));
    --font-family-medium:    var(--sus-font-family-medium,    url("Fonts/Montserrat/Montserrat-Medium.ttf"));
    --font-family-bold:      var(--sus-font-family-bold,      url("Fonts/Montserrat/Montserrat-Bold.ttf"));
    /* T-2216: black/italic were hardcoded url(...) with no --sus-font-family-* hook — a full
       replacement typeface could never bring its own black/italic cut. Same override pattern
       as the four weights above now applies to both. */
    --font-family-black:    var(--sus-font-family-black,    url("Fonts/Montserrat/Montserrat-Black.ttf"));
    --font-family-italic:   var(--sus-font-family-italic,   url("Fonts/Montserrat/Montserrat-Italic.ttf"));
    --font-family-light:    var(--sus-font-family-light,    url("Fonts/Montserrat/Montserrat-Light.ttf"));
    --font-family-heading:  var(--sus-font-family-heading,  var(--font-family-bold));
    --font-family-mono:     var(--sus-font-family-mono,     var(--font-family-regular));
    /* T-2216: narrow/display cut for large titles (e.g. IBM Plex Sans Condensed). No packaged
       fallback file ships for this — falls back to the heading family, same chain as
       SusFontAsset.ResolveCondensed() on the C# side. */
    --font-family-condensed: var(--sus-font-family-condensed, var(--font-family-heading));

    --main-font-family: var(--font-family-regular);
    -unity-font-definition: var(--font-family-regular);
}

/* ── Role marker classes (SusFontService.<Role>ClassName) ─────────────────
   T-2767: these classes used to be inert on the USS side — they existed only
   as C# query markers, and SusFontService wrote the FontDefinition inline.
   Now the class IS the mechanism: tag markup with it and the role's typeface
   applies through the token chain above, so a theme/skin override reaches it.

   Each rule is listed twice on purpose. The bare .sus-font-* form is the
   readable one; the ':root .sus-font-*' form carries two simple selectors
   (specificity 0,2,0) so a marker deliberately put on an element ALSO wins
   over a component's own single-class -unity-font-definition rule, which
   loads later in the cascade and would otherwise tie and win on order.
   A skin keeps the last word either way: its own selectors are compound, and
   it can redefine --sus-font-family-* instead of fighting the selector. */
.sus-font-regular,   :root .sus-font-regular   { -unity-font-definition: var(--font-family-regular); }
.sus-font-medium,    :root .sus-font-medium    { -unity-font-definition: var(--font-family-medium); }
.sus-font-bold,      :root .sus-font-bold      { -unity-font-definition: var(--font-family-bold); }
.sus-font-light,     :root .sus-font-light     { -unity-font-definition: var(--font-family-light); }
.sus-font-heading,   :root .sus-font-heading   { -unity-font-definition: var(--font-family-heading); }
.sus-font-mono,      :root .sus-font-mono      { -unity-font-definition: var(--font-family-mono); }
.sus-font-condensed, :root .sus-font-condensed { -unity-font-definition: var(--font-family-condensed); }

/* ── Semantic Size Aliases (L3) ──────────────────────────────
   Components should reference these, NOT --base-font-size-* directly.
   Override --sus-font-size-* in a custom USS sheet to re-scale. ── */
:root {
    --sus-font-size-caption:  var(--base-font-size-xs);
    --sus-font-size-small:    var(--base-font-size-sm);
    --sus-font-size-body:     var(--base-font-size-md);
    --sus-font-size-subtitle: var(--base-font-size-lg);
    --sus-font-size-heading3: var(--base-font-size-xl);
    --sus-font-size-heading2: var(--base-font-size-2xl);
    --sus-font-size-heading1: var(--base-font-size-3xl);
    --sus-font-size-hero:     var(--base-font-size-4xl);
}
