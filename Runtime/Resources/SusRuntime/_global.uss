/* ── SUS Global Reset & Utilities ──────────────────────────
   Auto-loaded by SusBootstrap.LoadTokenCascade() (after core tokens;
   downstream L4/L5 sheets register via RegisterCascadeStyleSheet).

   Purpose: normalize built-in Unity USS defaults + utilities.

   Override: place Assets/Resources/SusRuntime/_global.uss
             in your project to replace this default.
   ──────────────────────────────────────────────────────────── */

/* ── No aggressive reset — USS inherits font from parent naturally ─── */

/* ── ScrollView reset ─────────────────────────────────────── */
.unity-scroll-view__content-container {
    padding: 0;
}

/* ── Utility: hide element (display: none; Flex matching) ────
   Sole declaration (T-2653): downstream packages used to carry their own
   copy of this rule too — dropped, this is the one home; that consolidation
   stands regardless of the finding below.

   NOT reliable against a downstream component's own companion USS of equal
   apparent specificity (single class, e.g. { display: flex }). T-2653 tried
   raising specificity with a compound selector (.sus-hidden.sus-hidden,
   2 classes vs 1) to force a win against exactly such a rule; measured live
   it did NOT win — the element stayed display:flex with only "sus-hidden"
   added to its class list, no inline style (regression-locked by a test in
   each downstream package that hit this, not just this comment). Left as a
   plain single-class rule (not deleted): at least one downstream consumer
   hides purely via this class with no inline fallback and nothing else
   competes with it on display, so the rule still does its job there —
   deleting it would silently break that consumer. Do NOT rely on this class
   alone to hide anything that also carries a component rule setting display:
   set inline IStyle.display for those instead. ── */
.sus-hidden {
    display: none;
}

/* ── Utility: flex spacer ─────────────────────────────────── */
.sus-spacer {
    flex-grow: 1;
}

/* ── Utility: fill the parent's flex flow ───────────────────
   Replaces the inline `style.flexGrow = 1f` that SusApp (document root),
   SusScreenOutlet (mounted screen) and SusRouteView (active route screen)
   used to write from C# (R120/D-069). Same declaration as .sus-spacer,
   different intent: a spacer is an empty filler between siblings, this
   one makes a real screen take the outlet's height (without it an outlet
   whose children are absolute collapses to W×0 — see the note above).
   ─────────────────────────────────────────────────────────── */
.sus-grow {
    flex-grow: 1;
}

/* ── Slot container ───────────────────────────────────
   <slot> / <slot name="x"> compiles to a VisualElement created by
   SusComponent.GetSlotContainer(): classes `sus-slot sus-slot--<name>`,
   nested INSIDE the author's wrapper element. UI Toolkit lays it out
   as a column by default, so a row wrapper only positions this one
   box — repeat the direction on the container in component USS:
       .my-wrapper > .sus-slot { flex-direction: row; align-items: center; }
   The container itself stays layout-transparent (UI Toolkit defaults,
   restated here so a project override has a hook to replace).
   ──────────────────────────────────────────────────────────── */
.sus-slot {
    flex-shrink: 1;
}

/* ── Utility: text truncation ──────────────────────────────── */
.sus-text-truncate {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

/* ── Utility: visually hidden (accessible, not visible) ───── */
.sus-sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
}

/* ── Utility: flexible scroll container ───────────────────── */
.sus-scroll-y {
    overflow: hidden;
    flex-grow: 1;
}

/* ── Screen outlet / route screens ──────────────────────────
   Absolute children (splash/menu content) do NOT contribute to
   parent layout height. Without a sized outlet the screen collapses
   to W×0 (BoundsAudit). Root outlet fills the mount container;
   nested outlets stay in flex flow (lobby child regions).
   ─────────────────────────────────────────────────────────── */
.sus-screen-outlet,
.sus-route-view {
    flex-grow: 1;
    flex-direction: column;
    width: 100%;
    min-height: 0;
}

.sus-route-view--root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    flex-direction: column;
}

.sus-screen {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
}
