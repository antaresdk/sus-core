/*
 * Shell of the SUS storybook engine — zone A (navigation), the shell chrome around it and the
 * empty slots of zones B..E (plan ARCH-20260907-STORYBOOK-ENGINE.md §4.6, §6.1 step 3).
 *
 * This file lives NEXT TO THE CODE and is referenced by GUID from a [SerializeField] StyleSheet
 * (SusStorybookBehaviour) or loaded by package path in the Editor. It must NOT move under
 * Resources/: a package's Resources folder goes into every player build unconditionally, and a
 * buyer who never opens the storybook must not pay for its skin (plan §0.1).
 *
 * Every visual decision is here and none of it is in C#: the engine now lives in Runtime, where
 * R53/R120 judge appearance written through the C# style API.
 */

/* ── shell ─────────────────────────────────────────────────────────────── */

.sus-sb {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
    background-color: var(--sus-bg-page);
    color: var(--sus-text-primary);
}

.sus-sb__topbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 46px;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sus-border);
    background-color: var(--sus-bg-surface);
}

.sus-sb__burger {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    display: none;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--sus-border);
    border-radius: var(--sus-radius-sm);
    background-color: var(--sus-bg-surface);
    color: var(--sus-text-primary);
}

.sus-sb--narrow .sus-sb__burger {
    display: flex;
}

.sus-sb__crumbs {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 260px;
}

.sus-sb__spacer {
    flex-grow: 1;
}

.sus-sb__link {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-secondary);
    margin-right: 10px;
    max-width: 320px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sus-sb--narrow .sus-sb__link {
    display: none;
}

.sus-sb__share {
    height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: var(--sus-border);
    border-radius: var(--sus-radius-sm);
    background-color: var(--sus-bg-surface);
    color: var(--sus-text-primary);
    font-size: 12px;
}

.sus-sb__share:hover {
    border-color: var(--sus-border-hover);
}

.sus-sb__body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.sus-sb__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--sus-scrim);
    display: none;
}

.sus-sb--narrow.sus-sb--drawer-open .sus-sb__scrim {
    display: flex;
}

/* ── zone A: navigation ────────────────────────────────────────────────── */

.sus-sb-nav {
    flex-shrink: 0;
    width: 220px;
    flex-direction: column;
    min-height: 0;
    border-right-width: 1px;
    border-right-color: var(--sus-border);
    background-color: var(--sus-bg-surface);
}

.sus-sb--narrow .sus-sb-nav {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 260px;
    border-right-width: 1px;
    display: none;
}

.sus-sb--narrow.sus-sb--drawer-open .sus-sb-nav {
    display: flex;
}

.sus-sb-nav__head {
    flex-shrink: 0;
    padding-top: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 6px;
}

.sus-sb-nav__search {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 9px;
    padding-right: 9px;
    border-width: 1px;
    border-color: var(--sus-border);
    border-radius: var(--sus-radius-sm);
    background-color: var(--sus-bg-surface-variant);
}

.sus-sb-nav__search:focus-within {
    border-color: var(--sus-border-focus);
}

.sus-sb-nav__search-input {
    flex-grow: 1;
    font-size: 12px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
    color: var(--sus-text-primary);
}

.sus-sb-nav__search-input > #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    color: var(--sus-text-primary);
}

.sus-sb-nav__search-hint {
    -unity-font-definition: var(--font-family-mono);
    font-size: 10.5px;
    color: var(--sus-text-secondary);
    margin-left: 6px;
}

.sus-sb-nav__search-placeholder {
    position: absolute;
    left: 9px;
    font-size: 12px;
    color: var(--sus-text-secondary);
}

.sus-sb-nav__search-placeholder.sus-sb-hidden {
    display: none;
}

.sus-sb-nav__tabs {
    flex-direction: row;
    margin-top: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sus-border);
}

.sus-sb-nav__tab {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 2px;
    padding-right: 2px;
    -unity-text-align: middle-center;
    font-size: 11px;
    color: var(--sus-text-secondary);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin-bottom: -1px;
}

.sus-sb-nav__tab:hover {
    color: var(--sus-text-primary);
}

.sus-sb-nav__tab--active {
    color: var(--sus-text-primary);
    -unity-font-style: bold;
    border-bottom-color: var(--sus-primary);
}

.sus-sb-nav__list {
    flex-grow: 1;
    min-height: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 8px;
}

.sus-sb-nav__group {
    -unity-font-definition: var(--font-family-mono);
    -unity-font-style: bold;
    font-size: 10.5px;
    letter-spacing: 1px;
    color: var(--sus-text-secondary);
    margin-top: 12px;
    margin-bottom: 4px;
    margin-left: 8px;
    margin-right: 8px;
}

.sus-sb-nav__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: var(--sus-radius-sm);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    margin: 0;
    color: var(--sus-text-primary);
    font-size: 12.5px;
    -unity-text-align: middle-left;
}

.sus-sb-nav__row:hover {
    background-color: var(--sus-hover-overlay);
}

.sus-sb-nav__row--active {
    background-color: var(--sus-selected-overlay);
    color: var(--sus-primary);
    -unity-font-style: bold;
}

.sus-sb-nav__row-name {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sus-sb-nav__row-count {
    -unity-font-definition: var(--font-family-mono);
    font-size: 10.5px;
    color: var(--sus-text-secondary);
    margin-left: 8px;
    flex-shrink: 0;
}

.sus-sb-nav__empty {
    margin-top: 8px;
    margin-left: 2px;
    margin-right: 2px;
    padding: 10px;
    border-width: 1px;
    border-color: var(--sus-border);
    border-radius: var(--sus-radius-md);
    background-color: var(--sus-bg-surface-variant);
}

.sus-sb-nav__empty-title {
    color: var(--sus-text-primary);
    -unity-font-style: bold;
    font-size: 12px;
    margin-bottom: 4px;
    white-space: normal;
}

.sus-sb-nav__empty-text {
    color: var(--sus-text-secondary);
    font-size: 12px;
    white-space: normal;
}

.sus-sb-nav__empty-code {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-primary);
    background-color: var(--sus-bg-surface-raised);
    border-radius: var(--sus-radius-sm);
    padding: 6px 8px;
    margin-top: 8px;
    white-space: normal;
}

.sus-sb-nav__foot {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: var(--sus-border);
    padding: 9px 12px;
}

.sus-sb-nav__health {
    flex-direction: row;
    align-items: center;
}

.sus-sb-nav__dot {
    width: 7px;
    height: 7px;
    border-radius: var(--sus-radius-full);
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--sus-success);
}

.sus-sb-nav__dot--bad {
    background-color: var(--sus-error);
}

.sus-sb-nav__health-text,
.sus-sb-nav__version {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-secondary);
}

/* ── zones B..E ────────────────────────────────────────────────────────── */

.sus-sb-main {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
    min-height: 0;
}

.sus-sb-center {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.sus-sb-zone {
    flex-shrink: 0;
}

/* Zone B — environment (card T-3036, plan §4.4): chip group left, deep-link + share right. */
.sus-sb-env {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sus-border);
}

.sus-sb-env__bar {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    height: 30px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--sus-border);
    border-radius: var(--sus-radius-sm);
    background-color: var(--sus-bg-surface);
    overflow: hidden;
}

/* Mock-up: narrow mode scrolls the whole chip group as one horizontal strip. */
.sus-sb-env__chips {
    flex-direction: row;
    flex-grow: 1;
}

.sus-sb-env__chips > #unity-content-container {
    flex-direction: row;
    align-items: center;
}

.sus-sb-env__chip {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 28px;
    padding-left: 10px;
    padding-right: 10px;
    border-right-width: 1px;
    border-right-color: var(--sus-border);
}

.sus-sb-env__chip--last {
    border-right-width: 0;
}

.sus-sb-env__chip-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.sus-sb-env__chip-value {
    font-size: 12px;
    color: var(--sus-text-primary);
    white-space: nowrap;
}

/* Deep-link — the SAME Label the top bar used before this card (T-3033); only ≥1200px wide
 * (WideWidth) so it does not crowd the chip group (card T-3036, mock-up). */
.sus-sb-env__link {
    display: none;
    margin-left: 12px;
    margin-right: 10px;
}

.sus-sb--wide .sus-sb-env__link {
    display: flex;
}

/* Share — the SAME Button the top bar used before this card; icon always shown, its text label
 * hidden in narrow mode so the button collapses to an icon (card T-3036, mock-up: "кнопка share —
 * иконкой"). */
.sus-sb-env__share {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.sus-sb-env__share-icon {
    width: 14px;
    height: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.sus-sb-env__share-label {
    margin-left: 6px;
}

.sus-sb--narrow .sus-sb-env__share-label {
    display: none;
}

/* Zone C — stage. */
.sus-sb-stage {
    flex-grow: 1;
    min-height: 0;
    padding: 16px 20px 22px 20px;
}

.sus-sb-stage__title {
    font-size: 20px;
    -unity-font-style: bold;
    color: var(--sus-text-primary);
    margin-top: 8px;
}

.sus-sb-stage__purpose {
    font-size: 13px;
    color: var(--sus-text-secondary);
    margin-top: 4px;
    white-space: normal;
}

/* The instance canvas. The dotted grid is a 16x16 tile REPEATED by USS, not a mesh painted from
 * C#: the shell must not write appearance through the style API (R53/R120), and a tiled asset is
 * the only way UI Toolkit draws a repeating pattern. */
.sus-sb-stage__canvas {
    margin-top: 10px;
    padding: 22px;
    border-width: 1px;
    border-color: var(--sus-border);
    border-radius: var(--sus-radius-md);
    background-color: var(--sus-bg-page);
    background-image: url("canvas-dot.png");
    background-repeat: repeat;
    background-size: 16px 16px;
    min-height: 120px;
}

/* An open popup lives in the stage's OWN OverlayHost, which is a child of this canvas. The canvas
 * grows so the popup is inside the frame a screenshot takes, instead of being clipped away. */
.sus-sb-stage__canvas--overlay {
    min-height: 350px;
}

.sus-sb-stage__crumbs {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-secondary);
}

.sus-sb-stage__live-hint {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-secondary);
    margin-top: 22px;
}

/* ── zone C: the state matrix (card T-3038, plan §4.5 p. 2) ─────────────── */

.sus-sb-matrix {
    margin-top: 18px;
    flex-shrink: 0;
}

.sus-sb-matrix__toggle {
    align-self: flex-start;
    height: 20px;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: var(--font-family-mono);
    -unity-text-align: middle-left;
    font-size: 11px;
    color: var(--sus-text-secondary);
}

.sus-sb-matrix__toggle:hover {
    color: var(--sus-text-primary);
}

.sus-sb-matrix__scroll {
    margin-top: 8px;
    max-height: 280px;
}

.sus-sb-matrix__grid {
    flex-direction: column;
}

.sus-sb-matrix__row {
    flex-direction: row;
    align-items: center;
    height: 34px;
}

.sus-sb-matrix__row--head {
    height: 20px;
}

.sus-sb-matrix__rowlabel {
    width: 68px;
    flex-shrink: 0;
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sus-sb-matrix__colhead {
    width: 72px;
    flex-shrink: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--font-family-mono);
    font-size: 10.5px;
    color: var(--sus-text-secondary);
}

.sus-sb-matrix__cell {
    width: 72px;
    height: 34px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

/* A miniature, not a second live instance: the cell clips, the type scales down, and nothing in
 * the component is resized from C#. */
.sus-sb-matrix__item {
    max-width: 64px;
    font-size: 9px;
    flex-shrink: 1;
}

.sus-sb-matrix__cell-fail {
    font-size: 11px;
    color: var(--sus-text-disabled);
}

.sus-sb-matrix__note {
    margin-top: 8px;
    font-size: 11px;
    color: var(--sus-text-disabled);
    white-space: normal;
    max-width: 620px;
}

/* ── zone C: live measurements (card T-3038, plan §4.5 p. 5) ────────────── */

.sus-sb-sizes {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
    flex-shrink: 0;
}

.sus-sb-sizes__metrics,
.sus-sb-sizes__overlay {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-secondary);
    margin-right: 18px;
}

.sus-sb-stage__empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.sus-sb-stage__empty-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--sus-text-primary);
    margin-bottom: 6px;
}

.sus-sb-stage__empty-text {
    font-size: 12.5px;
    color: var(--sus-text-secondary);
    white-space: normal;
    max-width: 420px;
    -unity-text-align: middle-center;
}

/* Zone D — control panel. Empty until step 4 fills it. */
.sus-sb-panel {
    flex-shrink: 0;
    width: 300px;
    min-height: 0;
    border-left-width: 1px;
    border-left-color: var(--sus-border);
    background-color: var(--sus-bg-surface);
}

.sus-sb--narrow .sus-sb-panel {
    display: none;
}

/* ── Zone E — the probe strip (card T-3040, mock-up "Storybook Shell" zone E) ─────────────
 *
 * One line under the stage: what the story raised, what it promised and never raised, how
 * healthy the canvas is and whether the live render still matches its canon. Everything the
 * C# side of Probe/ does to it is a class flip — not one .style write (R53/R120).
 */
.sus-sb-probe {
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: var(--sus-border);
    background-color: var(--sus-bg-surface);
    padding: 9px 16px;
}

.sus-sb-probe__body {
    flex-direction: column;
}

.sus-sb-probe__strip {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.sus-sb-probe__title,
.sus-sb-probe__none,
.sus-sb-probe__health,
.sus-sb-probe__frame,
.sus-sb-probe__unfired,
.sus-sb-probe__chip {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-secondary);
}

.sus-sb-probe__title {
    margin-right: 8px;
}

.sus-sb-probe__chips {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.sus-sb-probe__chip {
    background-color: var(--sus-bg-surface-variant);
    border-radius: var(--sus-radius-sm);
    padding: 3px 7px;
    margin-right: 6px;
    color: var(--sus-text-primary);
}

.sus-sb-probe__none {
    margin-right: 8px;
}

/* "Promise without a deed" is a warning, not a failure: the story may simply not have been
 * clicked yet — which is exactly what the reader has to notice. */
.sus-sb-probe__unfired {
    color: var(--sus-warning);
    margin-right: 8px;
}

.sus-sb-probe__status {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: flex-end;
}

.sus-sb-probe__dot {
    width: 7px;
    height: 7px;
    border-radius: var(--sus-radius-full);
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--sus-success);
}

.sus-sb-probe__dot--bad {
    background-color: var(--sus-error);
}

.sus-sb-probe__health--bad,
.sus-sb-probe__frame--bad {
    color: var(--sus-error);
}

.sus-sb-probe__frame {
    margin-left: 14px;
}

.sus-sb-probe__anomalies {
    flex-direction: column;
    margin-top: 6px;
}

.sus-sb-probe__anomaly {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.sus-sb-probe__anomaly-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--sus-error);
}

.sus-sb-probe__anomaly-text {
    -unity-font-definition: var(--font-family-mono);
    font-size: 11px;
    color: var(--sus-text-primary);
    white-space: normal;
    flex-shrink: 1;
}

.sus-sb-slot-hint {
    font-size: 11px;
    color: var(--sus-text-disabled);
    -unity-font-definition: var(--font-family-mono);
}

/* Visibility switch of the shell — state through classes, never through the C# style API
 * (R53/R120). Prefixed on purpose: the stylesheet is applied to the shell root, so an unprefixed
 * .is-hidden would also reach every story mounted inside the stage. */
.sus-sb-hidden {
    display: none;
}

/* ============================================================================
 * Zone D - the generated control panel (card T-3034, mock-up "Controls Panel").
 *
 * Every visual decision of the panel is here: the C# side of Controls/ writes not a single
 * .style property, it only flips classes (R53/R120). Swatch colours come from the skin tokens
 * below, which is why a control can offer the skin primary without naming a colour in code.
 * ==========================================================================*/

.sus-sb-ctlpanel {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.sus-sb-ctlpanel__title {
    flex-shrink: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: 12px;
    color: var(--sus-text-primary);
    border-bottom-width: 1px;
    border-bottom-color: var(--sus-border);
}

.sus-sb-ctlpanel__groups {
    flex-grow: 1;
    min-height: 0;
}

.sus-sb-ctlpanel__group {
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 6px;
}

.sus-sb-ctlpanel__group-title {
    margin-top: 12px;
    margin-bottom: 2px;
    font-size: 9px;
    letter-spacing: 1px;
    color: var(--sus-text-disabled);
}

.sus-sb-ctlpanel__empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 18px;
    padding-right: 18px;
}

.sus-sb-ctlpanel__empty-title {
    font-size: 12px;
    color: var(--sus-text-secondary);
    margin-bottom: 6px;
}

.sus-sb-ctlpanel__empty-text {
    font-size: 11px;
    color: var(--sus-text-disabled);
    white-space: normal;
    -unity-text-align: middle-center;
}

.sus-sb-ctlpanel__foot {
    flex-shrink: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-width: 1px;
    border-top-color: var(--sus-border);
    background-color: var(--sus-bg-surface-variant);
}

.sus-sb-ctlpanel__counters {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.sus-sb-ctlpanel__count {
    font-size: 11px;
    color: var(--sus-text-secondary);
}

.sus-sb-ctlpanel__badge {
    font-size: 10px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: var(--sus-radius-sm);
    color: var(--sus-text-primary);
}

.sus-sb-ctlpanel__badge--ok {
    color: var(--sus-success);
    background-color: var(--sus-selected-overlay);
}

.sus-sb-ctlpanel__badge--defect {
    color: var(--sus-error);
    background-color: var(--sus-hover-overlay);
}

.sus-sb-ctlpanel__hole {
    margin-top: 4px;
    font-size: 10px;
    white-space: normal;
    color: var(--sus-text-secondary);
}

.sus-sb-ctlpanel__hole--dead {
    color: var(--sus-error);
}

.sus-sb-ctlpanel__hole--excluded {
    color: var(--sus-text-disabled);
}

/* -- one row ------------------------------------------------------------- */

.sus-sb-ctl {
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sus-border);
}

.sus-sb-ctl--inert {
    opacity: 0.45;
}

.sus-sb-ctl__head {
    flex-direction: row;
    align-items: center;
}

.sus-sb-ctl__name {
    font-size: 11px;
    color: var(--sus-text-primary);
    margin-right: 6px;
}

.sus-sb-ctl__badge {
    font-size: 9px;
    padding-left: 4px;
    padding-right: 4px;
    margin-right: 4px;
    border-radius: var(--sus-radius-sm);
    color: var(--sus-text-secondary);
    background-color: var(--sus-bg-surface-raised);
}

.sus-sb-ctl__badge--dead {
    color: var(--sus-error);
}

.sus-sb-ctl__badge--manual {
    color: var(--sus-text-disabled);
}

.sus-sb-ctl__body {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.sus-sb-ctl__note,
.sus-sb-ctl__dependency {
    margin-top: 3px;
    font-size: 9px;
    white-space: normal;
    color: var(--sus-text-disabled);
}

/* -- bool ---------------------------------------------------------------- */

.sus-sb-ctl__switch {
    width: 34px;
    height: 18px;
    padding: 0;
    margin: 0;
    border-radius: var(--sus-radius-full);
    border-width: 1px;
    border-color: var(--sus-border);
    background-color: var(--sus-bg-surface-raised);
    justify-content: center;
}

.sus-sb-ctl__switch--on {
    background-color: var(--sus-primary);
    border-color: var(--sus-primary);
}

.sus-sb-ctl__knob {
    width: 14px;
    height: 14px;
    margin-left: 2px;
    border-radius: var(--sus-radius-full);
    background-color: var(--sus-bg-page);
}

.sus-sb-ctl__switch--on .sus-sb-ctl__knob {
    margin-left: 18px;
}

/* -- closed sets --------------------------------------------------------- */

.sus-sb-ctl__segment {
    flex-grow: 1;
    flex-direction: row;
    padding: 2px;
    border-radius: var(--sus-radius-sm);
    background-color: var(--sus-bg-surface-raised);
}

.sus-sb-ctl__seg {
    flex-grow: 1;
    margin: 0;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 2px;
    padding-right: 2px;
    font-size: 10px;
    border-width: 0;
    border-radius: var(--sus-radius-sm);
    background-color: rgba(0, 0, 0, 0);
    color: var(--sus-text-secondary);
    text-overflow: ellipsis;
    overflow: hidden;
}

.sus-sb-ctl__seg--active {
    background-color: var(--sus-bg-surface);
    color: var(--sus-text-primary);
    border-width: 1px;
    border-color: var(--sus-border);
}

.sus-sb-ctl__dropdown {
    flex-grow: 1;
    margin: 0;
    font-size: 11px;
}

/* -- text, icon, numbers ------------------------------------------------- */

.sus-sb-ctl__text,
.sus-sb-ctl__number,
.sus-sb-ctl__hex,
.sus-sb-ctl__list-row {
    margin: 0;
    font-size: 11px;
}

.sus-sb-ctl__text {
    flex-grow: 1;
}

.sus-sb-ctl__number {
    width: 52px;
    margin-left: 6px;
}

.sus-sb-ctl__slider {
    flex-grow: 1;
    margin: 0;
}

.sus-sb-ctl__glyph {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

/* -- colour -------------------------------------------------------------- */

.sus-sb-ctl__swatches {
    flex-direction: row;
    align-items: center;
}

.sus-sb-ctl__swatch {
    width: 18px;
    height: 18px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 4px;
    padding: 0;
    border-radius: var(--sus-radius-sm);
    border-width: 1px;
    border-color: var(--sus-border);
}

.sus-sb-ctl__swatch--primary {
    background-color: var(--sus-primary);
}

.sus-sb-ctl__swatch--secondary {
    background-color: var(--sus-secondary);
}

.sus-sb-ctl__swatch--neutral {
    background-color: var(--sus-text-secondary);
}

.sus-sb-ctl__swatch--success {
    background-color: var(--sus-success);
}

.sus-sb-ctl__swatch--error {
    background-color: var(--sus-error);
}

.sus-sb-ctl__swatch--ink {
    background-color: var(--sus-text-primary);
}

.sus-sb-ctl__hex {
    width: 84px;
    margin-left: 4px;
}

.sus-sb-ctl__value {
    margin-left: 6px;
    font-size: 10px;
    color: var(--sus-text-disabled);
}

/* -- list and model ------------------------------------------------------ */

.sus-sb-ctl__list-summary {
    margin: 0;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: 10px;
    border-radius: var(--sus-radius-sm);
    border-width: 1px;
    border-color: var(--sus-border);
    background-color: var(--sus-bg-surface-raised);
    color: var(--sus-text-secondary);
}

.sus-sb-ctl__list {
    margin-top: 4px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: var(--sus-border);
}

.sus-sb-ctl__list-row {
    margin-bottom: 3px;
}

.sus-sb-ctl__list-add {
    margin: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: 10px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sus-text-secondary);
}

.sus-sb-ctl__mono {
    flex-grow: 1;
    font-size: 10px;
    color: var(--sus-text-secondary);
    -unity-font-definition: var(--font-family-mono);
}
