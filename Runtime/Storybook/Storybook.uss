/*
 * Shell of the SUS storybook engine — zone A (navigation), the shell chrome around it and the
 * empty slots of zones B..E (plan ARCH-20260907-STORYBOOK-ENGINE.md §4.6, §6.1 step 3).
 *
 * This file lives NEXT TO THE CODE and is referenced by GUID from a [SerializeField] StyleSheet
 * (SusStorybookBehaviour) or loaded by package path in the Editor. It must NOT move under
 * Resources/: a package's Resources folder goes into every player build unconditionally, and a
 * buyer who never opens the storybook must not pay for its skin (plan §0.1).
 *
 * Every visual decision is here and none of it is in C#: the engine now lives in Runtime, where
 * R53/R120 judge appearance written through the C# style API.
 */

/* ── shell ─────────────────────────────────────────────────────────────── */

/* ── the shell's OWN token set ────────────────────────────────────────────
 *
 * Plan ARCH-20260911-STORYBOOK-SHELL.md §4.2 and decisions D2 / D4 / D5 / D7 / D8 / D9,
 * cards T-3371 and T-3373.
 *
 * WHY the shell does not read the product's tokens: the shell is the INSTRUMENT, the story on
 * the canvas is the SUBJECT. While the shell read var(--sus-*) (165 references before T-3371)
 * a skin swap, a semantic-token edit or one click on the "theme" chip repainted the
 * instrument together with the subject — and then a dark screenshot of a component was taken
 * in a different viewer than the light one, so the difference could no longer be attributed
 * to the component. Every value below is the shell's own; nothing here resolves through a
 * product, kit or skin chain.
 *
 * Dark is the shell's resting state (the mock-up's default artboard). The light set lives on
 * .sb-shell--theme-light, put on THIS element by the shell's own "shell theme" chip in zone B —
 * a different chip from "theme", which keeps switching the SUBJECT (D4).
 *
 * Custom properties inherit, so the canvas subtree sees --sb-* too; nothing inside the canvas
 * reads them, and nothing outside the shell may (D20).
 */
.sb-shell {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;

    /* 13 colour names, dark set (§4.2 table) */
    --sb-bg: #18181a;
    --sb-panel: #1f1f21;
    --sb-ink: #ebeae6;
    --sb-muted: #9a9a93;
    --sb-line: #2f2f2c;
    --sb-line-soft: #282826;
    --sb-code: #262625;
    --sb-accent: #86cfa4;
    --sb-accent-ink: #0e1a13;
    --sb-accent-soft: rgba(134, 207, 164, 0.14);
    /* The accent has TWO jobs and one of them is text (T-3418). On the dark set one value does
       both: #86cfa4 as ink on --sb-panel measures 4.58, over the 4.5 floor, so the text accent
       here is the fill accent and the name exists only so the light set can part them. */
    --sb-accent-text: #86cfa4;
    --sb-ok: #7fcf9a;
    --sb-warn: #d9a84e;
    --sb-bad: #e6705f;

    /* Two names beyond the 13 of the table, both stated rather than smuggled in: the table has
       no overlay dim and no disabled ink, and mapping either onto --sb-muted would have made
       "secondary text" and "dead text" the same pixel — which is exactly what zone D's dead-prop
       badges have to tell apart. */
    --sb-scrim: rgba(0, 0, 0, 0.52);
    --sb-ink-disabled: #6a6a64;

    /* Typography (D5, D7). The two families of the mock-up, and no fallback caveat any more —
       the assets arrived (card T-3357): Instrument Sans carries the interface, Geist Mono every
       place that has to line up in a column or be copied by hand — story addresses, the live
       h / fs / pad / radius line, hotkey hints, the deep-link.

       This chain is the shell's OWN (D5): not one declaration below reads var(--font-family-*) or
       var(--sus-font-family-*), so a project or a skin that re-types the product cannot re-type
       the instrument. Montserrat stays exactly where it was — the product chain, which kit and
       game components resolve through _font.uss; it is simply no longer what the shell asks for.

       Weight is a FACE, not a number: UI Toolkit has no synthetic weights, so each rung names its
       own file. 400/500/600 are Instrument Sans Regular / Medium / SemiBold — SemiBold and not
       Bold, because the rung is called 600 and the family has that face (Montserrat, which was
       here before, does not ship one in this package, and Bold stood in for it).

       The path is relative to THIS sheet, and that is load-bearing: the sheet lives in a package
       mounted through file:, so an absolute Packages/ path would break for a git consumer while a
       relative one keeps the package root. */
    --sb-font-ui: url("../Resources/SusRuntime/Fonts/Instrument_Sans/InstrumentSans-Regular.ttf");
    --sb-font-mono: url("../Resources/SusRuntime/Fonts/Geist_Mono/GeistMono-Regular.ttf");
    --sb-fw-400: url("../Resources/SusRuntime/Fonts/Instrument_Sans/InstrumentSans-Regular.ttf");
    --sb-fw-500: url("../Resources/SusRuntime/Fonts/Instrument_Sans/InstrumentSans-Medium.ttf");
    --sb-fw-600: url("../Resources/SusRuntime/Fonts/Instrument_Sans/InstrumentSans-SemiBold.ttf");

    /* 8 size rungs (D7). The mock-up's two half-pixel sizes are collapsed into the ladder: in
       Unity's SDF text the difference is under a pixel of cap height, and a whole extra quarter
       of the ladder for a 2px span is not worth the ambiguity of "which 11 did you mean". */
    --sb-fs-10: 10px;
    --sb-fs-11: 11px;
    --sb-fs-12: 12px;
    --sb-fs-13: 13px;
    --sb-fs-14: 14px;
    --sb-fs-15: 15px;
    --sb-fs-16: 16px;
    --sb-fs-20: 20px;

    /* Radii (D8). PIXELS, never percent — in USS a percentage radius is not measured against
       what CSS measures it against. */
    --sb-r-xs: 2px;
    --sb-r-sm: 4px;
    --sb-r-md: 6px;
    --sb-r-lg: 8px;
    /* The inner radius under a 1px border. It is DERIVED (--sb-r-lg minus the border width) and
       is written out only because USS has no calc(); the derivation, not the number, is the rule. */
    --sb-r-lg-inner: 7px;

    /* Pill and circle radii are HALF THE HEIGHT OF THE SAME RUNG (D9), never a constant. That is
       why --sus-radius-full had to go: it is a fixed 20px, and on anything shorter than 40px
       Unity draws a lens instead of a pill — the 34x18 switch was the visible proof. Each pair
       below is "size, then half of it", so the invariant holds by construction. */
    --sb-h-ctl: 30px;
    --sb-pill-ctl: 15px;
    --sb-switch-w: 34px;
    --sb-switch-h: 18px;
    --sb-pill-switch: 9px;
    --sb-knob: 14px;
    --sb-pill-knob: 7px;
    --sb-dot: 8px;
    --sb-pill-dot: 4px;

    /* Reserved zone sizes and grid steps (§4.2, D15, D19). None of them depends on content. */
    --sb-topbar-h: 46px;
    --sb-zone-a-w: 220px;
    --sb-zone-a-drawer-w: 260px;
    --sb-zone-d-w: 300px;
    /* MINIMUMS of a matrix cell, not its size (card T-3481, decision d:360869). A cell grows to
       whatever the instance inside it turns out to need; these two only keep a row of tiny
       components from collapsing into a line of dots. */
    --sb-matrix-cell-w: 72px;
    --sb-matrix-cell-h: 34px;
    --sb-matrix-label-w: 68px;
    /* The canvas is ONE number, declared here, before the first layout pass (D18): an open
       popover must not be able to change it. */
    --sb-canvas-h: 350px;
    --sb-canvas-min-w: 320px;
    /* Side of the dotted tile of the canvas, card T-3444. It has to be STATED: the initial value
       of `background-size` in UI Toolkit is 100% 100%, not the image's own size, so a tile left
       unstated is stretched over the whole box and `background-repeat` has nothing left to
       repeat. Owner's report: "a grey square in the top-left corner of every preview area" —
       that square was this 16x16 tile blown up to 880x350 with point filtering. */
    --sb-canvas-dot: 16px;
    /* The live-size line of zone C, D15: a RESERVED width, so the label does not resize when the
       number it prints changes width. 56 characters is the longest form the writer can emit —
       "h 1080 · fs 13.5 · pad 22.5 · radius 12  (resolvedStyle)" (SusStorySizes.Refresh) — and
       340px holds it at --sb-fs-11 with room for a wider face later. */
    --sb-sizes-w: 340px;
    /* Scrollbar band, mock-up: 8px and no arrow buttons (D12). */
    --sb-scrollbar: 8px;

    background-color: var(--sb-bg);
    color: var(--sb-ink);
    -unity-font-definition: var(--sb-font-ui);
}

/* Light set: only the 13 names plus the two stated extras are redefined — geometry, type and
   radii are theme-independent by construction. */
.sb-shell--theme-light {
    --sb-bg: #f3f2ee;
    --sb-panel: #fbfaf7;
    --sb-ink: #1c1c1a;
    --sb-muted: #6b6b64;
    --sb-line: #dcdad3;
    --sb-line-soft: #e9e7e0;
    --sb-code: #eceae4;
    --sb-accent: #1f7a52;
    --sb-accent-ink: #ffffff;
    --sb-accent-soft: rgba(31, 122, 82, 0.12);
    /* The light set's SECOND accent (T-3418), and the reason it exists is a number: #1f7a52 was
       picked to be read ON a dark ground, and as ink on --sb-panel (#fbfaf7) it measures 2.34 --
       the selected row of zone A was the one name in the shell below the 4.5 floor. Darkening
       --sb-accent itself was the wrong lever: that value is also a FILL (a button ground under
       --sb-accent-ink), and a fill and an ink want opposite ends of the ramp on a light ground.
       #0c3121 is the same hue four fifths of the way down it, and it clears the floor against
       BOTH grounds the selected row actually sits on: 4.98 on the panel, and 4.64 on the panel
       seen through the row's own --sb-accent-soft tint. */
    --sb-accent-text: #0c3121;
    --sb-ok: #1f8f5f;
    --sb-warn: #a8741c;
    --sb-bad: #c2422f;
    --sb-scrim: rgba(0, 0, 0, 0.32);
    --sb-ink-disabled: #9d9d95;
}

.sb-shell__topbar {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    height: 46px;
    padding-left: 12px;
    padding-right: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sb-line);
    background-color: var(--sb-panel);
}

.sb-shell__burger {
    width: 30px;
    height: 30px;
    margin-right: 8px;
    display: none;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-sm);
    background-color: var(--sb-panel);
    color: var(--sb-ink);
}

.sb-shell--narrow .sb-shell__burger {
    display: flex;
}

.sb-shell__crumbs {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 260px;
}

.sb-shell__spacer {
    flex-grow: 1;
}

.sb-shell__link {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    margin-right: 10px;
    max-width: 320px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sb-shell--narrow .sb-shell__link {
    display: none;
}

.sb-shell__share {
    height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-sm);
    background-color: var(--sb-panel);
    color: var(--sb-ink);
    font-size: var(--sb-fs-12);
}

.sb-shell__share:hover {
    border-color: var(--sb-muted);
}

.sb-shell__body {
    flex-grow: 1;
    flex-direction: row;
    min-height: 0;
}

.sb-shell__scrim {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--sb-scrim);
    display: none;
}

.sb-shell--narrow.sb-shell--drawer-open .sb-shell__scrim {
    display: flex;
}

/* ── zone A: navigation ────────────────────────────────────────────────── */

.sb-nav {
    flex-shrink: 0;
    width: 220px;
    flex-direction: column;
    min-height: 0;
    border-right-width: 1px;
    border-right-color: var(--sb-line);
    background-color: var(--sb-panel);
}

.sb-shell--narrow .sb-nav {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 260px;
    border-right-width: 1px;
    display: none;
}

.sb-shell--narrow.sb-shell--drawer-open .sb-nav {
    display: flex;
}

.sb-nav__head {
    flex-shrink: 0;
    padding-top: 12px;
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 6px;
}

.sb-nav__search {
    flex-direction: row;
    align-items: center;
    height: 30px;
    padding-left: 9px;
    padding-right: 9px;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-sm);
    background-color: var(--sb-code);
}

.sb-nav__search--focus {
    border-color: var(--sb-accent);
}

.sb-nav__search-input {
    flex-grow: 1;
    font-size: var(--sb-fs-12);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
    color: var(--sb-ink);
}

.sb-nav__search-input > #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    color: var(--sb-ink);
}

.sb-nav__search-hint {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    margin-left: 6px;
}

.sb-nav__search-placeholder {
    position: absolute;
    left: 9px;
    font-size: var(--sb-fs-12);
    color: var(--sb-muted);
}

.sb-nav__search-placeholder.sb-hidden {
    display: none;
}

/* Zone A -- the row of history arrows (T-3406, rules T-3419). Its own inline layout: until this
   rule existed the row borrowed .sb-nav__tabs standing next to it, and with the layout came
   the bottom border that belongs to a tab strip and not to a pair of arrows. */
.sb-nav__history {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

/* Square by construction -- ONE rung of the ladder on both axes (R139 L2: half of it is 15, the
   radius is 4), so the glyph is centred in a box and not in a slab. Appearance comes from the
   GHOST role at the end of the sheet; declared here is only the box and the glyph inside it. */
.sb-nav__back,
.sb-nav__forward {
    width: var(--sb-h-ctl);
    height: var(--sb-h-ctl);
    margin: 0;
    padding: 0;
    border-radius: var(--sb-r-sm);
    -unity-text-align: middle-center;
    font-size: var(--sb-fs-14);
}

.sb-nav__forward {
    margin-left: 4px;
}

.sb-nav__tabs {
    flex-direction: row;
    margin-top: 10px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sb-line);
}

.sb-nav__tab {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    min-width: 0;
    margin: 0;
    padding-top: 6px;
    padding-bottom: 8px;
    padding-left: 2px;
    padding-right: 2px;
    -unity-text-align: middle-center;
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    margin-bottom: -1px;
}

.sb-nav__tab:hover {
    color: var(--sb-ink);
}

.sb-nav__tab--active {
    color: var(--sb-ink);
    -unity-font-definition: var(--sb-fw-600);
    border-bottom-color: var(--sb-accent);
}

.sb-nav__list {
    flex-grow: 1;
    min-height: 0;
    padding-left: 6px;
    padding-right: 6px;
    padding-bottom: 8px;
}

.sb-nav__group {
    -unity-font-definition: var(--sb-font-mono);
    -unity-font-definition: var(--sb-fw-600);
    font-size: var(--sb-fs-11);
    letter-spacing: 1px;
    color: var(--sb-muted);
    margin-top: 12px;
    margin-bottom: 4px;
    margin-left: 8px;
    margin-right: 8px;
}

.sb-nav__row {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 8px;
    padding-right: 8px;
    border-radius: var(--sb-r-sm);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    margin: 0;
    color: var(--sb-ink);
    font-size: var(--sb-fs-13);
    -unity-text-align: middle-left;
}

.sb-nav__row:hover {
    background-color: var(--sb-line-soft);
}

.sb-nav__row--active {
    background-color: var(--sb-accent-soft);
    color: var(--sb-accent-text);
    -unity-font-definition: var(--sb-fw-600);
}

.sb-nav__row-name {
    flex-grow: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sb-nav__row-count {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    margin-left: 8px;
    flex-shrink: 0;
}

.sb-nav__empty {
    margin-top: 8px;
    margin-left: 2px;
    margin-right: 2px;
    padding: 10px;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-md);
    background-color: var(--sb-code);
}

.sb-nav__empty-title {
    color: var(--sb-ink);
    -unity-font-definition: var(--sb-fw-600);
    font-size: var(--sb-fs-12);
    margin-bottom: 4px;
    white-space: normal;
}

.sb-nav__empty-text {
    color: var(--sb-muted);
    font-size: var(--sb-fs-12);
    white-space: normal;
}

.sb-nav__empty-code {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-ink);
    background-color: var(--sb-code);
    border-radius: var(--sb-r-sm);
    padding: 6px 8px;
    margin-top: 8px;
    white-space: normal;
}

.sb-nav__foot {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: var(--sb-line);
    padding: 9px 12px;
}

.sb-nav__health {
    flex-direction: row;
    align-items: center;
}

.sb-nav__dot {
    width: var(--sb-dot);
    height: var(--sb-dot);
    border-radius: var(--sb-pill-dot);
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--sb-ok);
}

.sb-nav__dot--bad {
    background-color: var(--sb-bad);
}

.sb-nav__health-text,
.sb-nav__version {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
}

/* ── zones B..E ────────────────────────────────────────────────────────── */

.sb-main {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
    min-height: 0;
}

.sb-center {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
}

.sb-zone {
    flex-shrink: 0;
}

/* Zone B — environment (card T-3036, plan §4.4): chip group left, deep-link + share right. */
.sb-env {
    flex-direction: row;
    align-items: center;
    height: 38px;
    padding-left: 16px;
    padding-right: 16px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sb-line);
}

/* Card T-3364 RETURN (ux-reviewer-4): `height: 30px` used to be a hard cap. With overflow hidden
 * on a fixed-height cross axis, Yoga measures the ScrollView child against that 30px ceiling even
 * though nothing here clips visually while the child fits — but once the horizontal scroller band
 * (8px) joined the 28px chip row, the ScrollView's own measure pass had to fit BOTH inside 30px,
 * so it squeezed the content viewport down to 20px instead of letting the bar grow. `min-height`
 * keeps the same 30px at rest (chips are 28px, so the floor still wins) but lets the bar grow to
 * whatever the ScrollView actually needs once a horizontal scroller is showing. */
.sb-env__bar {
    flex-grow: 1;
    flex-shrink: 1;
    min-width: 0;
    min-height: 30px;
    flex-direction: row;
    align-items: center;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-sm);
    background-color: var(--sb-panel);
    overflow: hidden;
}

/* Mock-up: narrow mode scrolls the whole chip group as one horizontal strip. The chips themselves
 * get their row layout from #unity-content-container below (D20-safe: that selector never leaves
 * this ScrollView) — this rule must NOT also set flex-direction: row, because THIS is the
 * ScrollView's own root, and a ScrollView's internal structure needs its root in Unity's default
 * COLUMN direction: the content-and-vertical-scroll-container sits above the horizontal scroller,
 * stretched to the full width by the column's default align-items: stretch. Card T-3364 (RETURN,
 * ux-reviewer report 2026-09-24-ux-reviewer-3): with flex-direction: row on this element the two
 * became row-siblings instead, so the horizontal scroller shrank to its content size — an 8x8
 * square pinned to the right edge (Auto correctly decided a scroller was needed; the row rule is
 * what turned it into a decoration nobody could drag). */
.sb-env__chips {
    flex-grow: 1;
}

/* Card T-3364 RETURN: `.unity-scroll-view__content-and-vertical-scroll-container` is the column's
 * OTHER stacked child, next to the horizontal scroller band (D20-safe reach, direct-child form,
 * same reasoning as the "== ScrollView: an 8px band ==" section below). Once the horizontal band
 * joined the column, Yoga's split between these two children measured the viewport 1px short of
 * a chip's own 28px (27px) — a rounding remainder with nowhere named to go. A floor here is what
 * the live measurement (T-3364 builder harness) found closes it exactly to 28; `.sb-env__chips`
 * itself carrying the same min-height does nothing, because the split is decided one level down,
 * not at the ScrollView's own outer box. */
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container {
    min-height: 28px;
}

.sb-env__chips > #unity-content-container {
    flex-direction: row;
    align-items: center;
}

.sb-env__chip {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 28px;
    padding-left: 10px;
    padding-right: 10px;
    border-right-width: 1px;
    border-right-color: var(--sb-line);
}

.sb-env__chip--last {
    border-right-width: 0;
}

/* The instrument's own theme chip (card T-3371, D4). It sits behind a heavier divider and on the
 * shell's panel tone, so "this switch is about the viewer" is visible without reading the glyph:
 * two chips both able to say "dark" is exactly the ambiguity this rule removes. */
.sb-env__chip--shell {
    border-left-width: 1px;
    border-left-color: var(--sb-line);
    background-color: var(--sb-code);
}

.sb-env__chip-icon {
    width: 14px;
    height: 14px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.sb-env__chip-value {
    font-size: var(--sb-fs-12);
    color: var(--sb-ink);
    white-space: nowrap;
}

/* Deep-link — the SAME Label the top bar used before this card (T-3033); only ≥1200px wide
 * (WideWidth) so it does not crowd the chip group (card T-3036, mock-up). */
.sb-env__link {
    display: none;
    margin-left: 12px;
    margin-right: 10px;
}

.sb-shell--wide .sb-env__link {
    display: flex;
}

/* Share — the SAME Button the top bar used before this card; icon always shown, its text label
 * hidden in narrow mode so the button collapses to an icon (card T-3036, mock-up: "the share
 * button becomes an icon"). */
.sb-env__share {
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
}

.sb-env__share-icon {
    width: 14px;
    height: 14px;
    -unity-background-scale-mode: scale-to-fit;
}

.sb-env__share-label {
    margin-left: 6px;
}

.sb-shell--narrow .sb-env__share-label {
    display: none;
}

/* Zone C — stage. */
.sb-stage {
    flex-grow: 1;
    min-height: 0;
    padding: 16px 20px 22px 20px;
}

.sb-stage__title {
    font-size: var(--sb-fs-20);
    -unity-font-definition: var(--sb-fw-600);
    color: var(--sb-ink);
    margin-top: 8px;
}

.sb-stage__purpose {
    font-size: var(--sb-fs-13);
    color: var(--sb-muted);
    margin-top: 4px;
    white-space: normal;
}

/* The instance canvas. The dotted grid is a 16x16 tile REPEATED by USS, not a mesh painted from
 * C#: the shell must not write appearance through the style API (R53/R120), and a tiled asset is
 * the only way UI Toolkit draws a repeating pattern. */
.sb-stage__canvas {
    margin-top: 10px;
    padding: 22px;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-md);
    background-color: var(--sb-bg);
    /* Card T-3359. The canvas used to leave `color` to inheritance, and inheritance is exactly
       what does NOT repaint reliably here: toggling the shell's own light/dark chip (the
       "shell-theme" axis, D4) swaps `--sb-bg` and `--sb-ink` together on .sb-shell, and the
       explicit `background-color: var(--sb-bg)` above picks that up on the next layout pass —
       but the INHERITED `color` a descendant with no rule of its own carries stayed pinned to
       whatever value it first resolved to. Measured live on sus-dev before this line existed:
       shell-theme cycled dark -> light, canvas backgroundColor moved to RGBA(0.953, 0.949,
       0.933) (correct, --sb-bg light) while color stayed at RGBA(0.941, 0.941, 0.941) — the
       dark set's near-white ink, frozen — for a contrast ratio of about 1:1 against the now
       light ground. The fix is the same token pair as the background, stated directly instead
       of left to inheritance, so it re-resolves on the same pass as the background it has to
       stay readable against. */
    color: var(--sb-ink);
    background-image: url("canvas-dot.png");
    background-repeat: repeat;
    /* Card T-3444. The size is STATED at the tile's own 16x16, and stating it is what keeps the
       image unstretched (R51/D-028) — the opposite of what the previous comment here claimed.
       Omitting `background-size` does not mean "intrinsic size": its initial value is
       100% 100%, so the tile was drawn once across the whole canvas and its single dot came out
       as a grey rectangle in the top-left corner, which is exactly what the owner reported.
       Measured in Play before the fix: backgroundSize 100%/100% on an 880x350 canvas carrying a
       16x16 texture. The container is not resized to the picture and the picture is not
       stretched to the container: it is drawn at its own size and repeated. */
    /* sus:stretch the dot tile is drawn at its own 16x16 size, not stretched: UI Toolkit
       defaults background-size to 100% 100%, so the natural size has to be stated on both
       axes explicitly - that is what keeps the grid even instead of one blown-up dot (T-3444). */
    background-size: var(--sb-canvas-dot) var(--sb-canvas-dot);

    /* Card T-3378, decision D18. The canvas used to be min-height:120px and grew to 350px the
       moment a popover opened, so every story with a popover jumped 230px — the loudest instance
       of "everything moves". It also had no overflow at all, so a story wider than the stage was
       not clipped but UNREACHABLE (the stage scrolls vertically only).
       The fix is one number, declared here before the first layout pass: the canvas never
       resizes, for any story or any popover, which is also what makes two screenshots of the same
       address comparable between runs. A subject bigger than the canvas is clipped visibly and
       scrolled to — it does not push the canvas open. */
    height: var(--sb-canvas-h);
    min-height: var(--sb-canvas-h);
    max-height: var(--sb-canvas-h);
    min-width: var(--sb-canvas-min-w);
    max-width: 100%;
    overflow: hidden;
}

/* Card T-3359 (RETURN, ux-reviewer report 2026-09-24-ux-reviewer-3). The ground above still
   followed `--sb-bg`, which is the SHELL's own theme chip (D4, ShellThemeAxis on .sb-shell) — but
   everything painted ON this element follows a DIFFERENT chip: "theme" binds straight to THIS
   element (previewRoot == QaCanvas, SusBuiltinEnvAxes.cs, D27), adding `.theme-dark` /
   `.theme-light` here directly, and every subject on the canvas resolves its own ink and tonal
   fill against that class. When the two chips disagree (e.g. shell-theme stayed dark while theme
   went light), the ground stayed shell-dark under a subject painting itself light, and the tonal
   alert measured 1.26:1 against it (matching pairs measured 12.16 / 15.19, report table).
   The fix reads no product token (D2 still holds: SUBJECT is not touched, only this element's OWN
   ground) — it just answers the class the SUBJECT's own axis already put here, with the shell's
   OWN two values (the same 13-name dark/light pair the shell chip already owns, §4.2), instead of
   with a value gated by the unrelated shell-theme chip. Specificity (.sb-stage__canvas.theme-dark
   beats .sb-stage__canvas) makes this win regardless of source order. */
.sb-stage__canvas.theme-dark {
    background-color: #18181a;
    color: #ebeae6;
}

.sb-stage__canvas.theme-light {
    background-color: #f3f2ee;
    color: #1c1c1a;
}

.sb-stage__crumbs {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
}

.sb-stage__live-hint {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    margin-top: 22px;
}

/* ── zone C: the state matrix (card T-3038, plan §4.5 p. 2) ─────────────── */

.sb-matrix {
    margin-top: 18px;
    flex-shrink: 0;
}

.sb-matrix__toggle {
    align-self: flex-start;
    height: 20px;
    padding-left: 0;
    padding-right: 0;
    margin-left: 0;
    margin-right: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: var(--sb-font-mono);
    -unity-text-align: middle-left;
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
}

.sb-matrix__toggle:hover {
    color: var(--sb-ink);
}

.sb-matrix__scroll {
    margin-top: 8px;
    max-height: 280px;
}

.sb-matrix__grid {
    flex-direction: column;
}

/* Card T-3481: a MINIMUM and no clipping. `height` plus `overflow: hidden` made a row a guillotine
 * - a component taller than 34px was cut instead of being shown, and the cut was invisible because
 * the same declaration hid it. The row is now as tall as its tallest cell, and the matrix scrolls. */
.sb-matrix__row {
    flex-direction: row;
    align-items: flex-start;
    min-height: var(--sb-matrix-cell-h);
    flex-shrink: 0;
}

.sb-matrix__row--head {
    min-height: 20px;
    align-items: center;
}

.sb-matrix__rowlabel {
    width: var(--sb-matrix-label-w);
    flex-shrink: 0;
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.sb-matrix__colhead {
    min-width: var(--sb-matrix-cell-w);
    flex-shrink: 0;
    /* T-3355 RETURN: Unity's default Label carries its own margin (measured 2px left / 4px
       right on this build) — irrelevant on a lone label, but here it is laid out in the SAME
       row as its sibling colheads, so that margin adds to each one's box and the row drifts by
       margin-left+margin-right per column (measured 6px/column, 18px by the 4th head on this
       story - the mechanism behind the up-to-785px drift on wider grids). `.sb-matrix__cell`
       right below carries no such margin, so the fix is here: zero it so a head's box is
       exactly its measured width, same as its cell. */
    margin: 0;
    -unity-text-align: middle-center;
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
}

/* Card T-3481: the cell GROWS. The declared width/height became minimums and the clipping is
 * gone; SusStoryMatrix.SizeColumns then gives every cell of a column the measured width of the
 * widest instance in it, so the grid stays aligned without any cell being smaller than what it
 * holds. */
.sb-matrix__cell {
    min-width: var(--sb-matrix-cell-w);
    min-height: var(--sb-matrix-cell-h);
    flex-shrink: 0;
    flex-grow: 0;
    align-items: center;
    justify-content: center;
}

/* The wrapper the cell measures. It declares NOTHING about size any more.
 *
 * What was here until card T-3481, and why it is gone: `max-width: 64px; max-height: 28px;
 * overflow: hidden`, introduced by T-3355 to stop tall components from breaking their row. It
 * stopped the breakage by amputation. The ux-reviewer sweep of 2026-09-11 counted the bill: 460
 * of 537 cells across 103 stories showed a cut-off component, and on kit/atoms/button the caption
 * "Start Quest" was 81px of text in a 28px box - 53 invisible pixels out of 81, in all 18 cells,
 * while the widget reported itself healthy. A declared `overflow` is evidence of a broken
 * promise, never a defence for one (decisions d:3750a2 and d:ef1a8a).
 *
 * The row-breaking T-3355 was about is now answered where it belongs: the row is a minimum, the
 * cells of a column share one measured width, and the matrix scrolls on both axes.
 *
 * Card T-3421: this dresses the cell's WRAPPER, not the instance. The shell names its own boxes
 * and leaves the product's classes to the product (campaign T-3388). */
.sb-matrix__item {
    flex-shrink: 0;
}

/* The switcher (card T-3482): the states of a component too large for a grid. One instance at
 * natural size, one button per state, and the reason in the note underneath. */
.sb-matrix__states {
    flex-direction: row;
    flex-wrap: wrap;
    margin-bottom: 8px;
}

.sb-matrix__state {
    height: 20px;
    margin-left: 0;
    margin-right: 6px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: var(--sb-line);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: var(--sb-font-ui);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
}

.sb-matrix__state:hover {
    color: var(--sb-ink);
}

.sb-matrix__state--on {
    color: var(--sb-ink);
    border-color: var(--sb-ink-disabled);
    background-color: var(--sb-code);
}

.sb-matrix__solo {
    align-items: flex-start;
}

/* Where ONE instance is measured before the mode is decided (card T-3482). It has to be laid out
 * - `display: none` would report nothing - and it must not be seen, which is exactly what
 * `visibility: hidden` is for. Absolute, so it takes no room in the widget. */
.sb-matrix__measure {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: var(--sb-canvas-h);
    visibility: hidden;
    align-items: flex-start;
    justify-content: flex-start;
}

.sb-matrix__cell-fail {
    font-size: var(--sb-fs-11);
    color: var(--sb-ink-disabled);
}

.sb-matrix__note {
    margin-top: 8px;
    font-size: var(--sb-fs-11);
    color: var(--sb-ink-disabled);
    white-space: normal;
    max-width: 620px;
}

/* ── zone C: live measurements (card T-3038, plan §4.5 p. 5) ────────────── */

.sb-sizes {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 10px;
    flex-shrink: 0;
}

.sb-sizes__metrics,
.sb-sizes__overlay {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    margin-right: 18px;
}

/* Card T-3389, plan §4.7: a subject that does not fit says so. The line is the shell's own
   voice about the frame rather than a measurement of the component - full sentences ("wider
   than the window - scroll sideways for the rest"), not a row of numbers that has to line up
   in a column, so it takes the interface face and the accent colour of a hint rather than the
   mono chain and the muted grey of the numbers next to it (R144: a mono-place is data read
   character by character, and prose is not that). It reserves no box: the note is absent far
   more often than present, and an empty reserved column would cost zone C width on every story
   that fits. */
.sb-sizes__fit {
    -unity-font-definition: var(--sb-font-ui);
    font-size: var(--sb-fs-11);
    color: var(--sb-accent);
    margin-right: 18px;
    white-space: normal;
}

/* D15, card T-3396: the live-size line RESERVES its box. The C# half of the loop is already open
   (SusStorySizes stopped subscribing to the geometry of the element it measures, and writes only
   on a real text change) — but the WIDTH of the label was still a function of its text, so a
   story going from "h 8" to "h 1080" still moved zone C sideways. One declared number ends that:
   the box is the same whatever it prints. The face is --sb-font-mono, Geist Mono since card
   T-3357, and 340px was sized with that swap already in mind. */
.sb-sizes__metrics {
    min-width: var(--sb-sizes-w);
    flex-shrink: 0;
}

.sb-stage__empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 32px;
}

.sb-stage__empty-title {
    font-size: var(--sb-fs-15);
    -unity-font-definition: var(--sb-fw-600);
    color: var(--sb-ink);
    margin-bottom: 6px;
}

.sb-stage__empty-text {
    font-size: var(--sb-fs-13);
    color: var(--sb-muted);
    white-space: normal;
    max-width: 420px;
    -unity-text-align: middle-center;
}

/* Zone D — control panel. */
.sb-panel {
    flex-shrink: 0;
    width: var(--sb-zone-d-w);
    min-height: 0;
    border-left-width: 1px;
    border-left-color: var(--sb-line);
    background-color: var(--sb-panel);
}

/* Card T-3377, decision D25. Below 800px this rule used to be a bare `display: none` on the whole
 * zone: the props panel disappeared with no button, no drawer and no label, so the storybook at
 * 640 was a viewer with no controls and the question "how do I change a prop here" had no answer.
 * Zone A had already been given a burger, a drawer, a scrim and Ctrl+K at the same threshold —
 * zone D now reuses exactly that mechanism instead of being stacked under zone C, because
 * stacking pushes the stage off screen and kills the constant canvas size D18 depends on.
 * A zone is either present or has a NAMED entry; "gone" is not a third option. */
.sb-shell--narrow .sb-panel {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: var(--sb-zone-a-drawer-w);
    border-left-width: 1px;
    display: none;
}

.sb-shell--narrow.sb-shell--panel-open .sb-panel {
    display: flex;
}

.sb-shell--narrow.sb-shell--panel-open .sb-shell__scrim {
    display: flex;
}

/* ── Zone E — the probe strip (card T-3040, mock-up "Storybook Shell" zone E) ─────────────
 *
 * One line under the stage: what the story raised, what it promised and never raised, how
 * healthy the canvas is and whether the live render still matches its canon. Everything the
 * C# side of Probe/ does to it is a class flip — not one .style write (R53/R120).
 */
.sb-probe {
    flex-shrink: 0;
    border-top-width: 1px;
    border-top-color: var(--sb-line);
    background-color: var(--sb-panel);
    padding: 9px 16px;
}

.sb-probe__body {
    flex-direction: column;
}

.sb-probe__strip {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.sb-probe__title,
.sb-probe__none,
.sb-probe__health,
.sb-probe__frame,
.sb-probe__unfired,
.sb-probe__chip {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
}

.sb-probe__title {
    margin-right: 8px;
}

.sb-probe__chips {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.sb-probe__chip {
    background-color: var(--sb-code);
    border-radius: var(--sb-r-sm);
    padding: 3px 7px;
    margin-right: 6px;
    color: var(--sb-ink);
}

.sb-probe__none {
    margin-right: 8px;
}

/* "Promise without a deed" is a warning, not a failure: the story may simply not have been
 * clicked yet — which is exactly what the reader has to notice. */
.sb-probe__unfired {
    color: var(--sb-warn);
    margin-right: 8px;
}

.sb-probe__status {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    justify-content: flex-end;
}

.sb-probe__dot {
    width: var(--sb-dot);
    height: var(--sb-dot);
    border-radius: var(--sb-pill-dot);
    margin-right: 6px;
    flex-shrink: 0;
    background-color: var(--sb-ok);
}

.sb-probe__dot--bad {
    background-color: var(--sb-bad);
}

.sb-probe__health--bad,
.sb-probe__frame--bad {
    color: var(--sb-bad);
}

.sb-probe__frame {
    margin-left: 14px;
}

.sb-probe__anomalies {
    flex-direction: column;
    margin-top: 6px;
}

.sb-probe__anomaly {
    flex-direction: row;
    align-items: center;
    margin-bottom: 3px;
}

.sb-probe__anomaly-icon {
    width: 13px;
    height: 13px;
    flex-shrink: 0;
    margin-right: 8px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--sb-bad);
}

.sb-probe__anomaly-text {
    -unity-font-definition: var(--sb-font-mono);
    font-size: var(--sb-fs-11);
    color: var(--sb-ink);
    white-space: normal;
    flex-shrink: 1;
}

.sb-slot-hint {
    font-size: var(--sb-fs-11);
    color: var(--sb-ink-disabled);
    -unity-font-definition: var(--sb-font-mono);
}

/* Visibility switch of the shell — state through classes, never through the C# style API
 * (R53/R120). Prefixed on purpose: the stylesheet is applied to the shell root, so an unprefixed
 * .is-hidden would also reach every story mounted inside the stage. */
.sb-hidden {
    display: none;
}

/* ============================================================================
 * Zone D - the generated control panel (card T-3034, mock-up "Controls Panel").
 *
 * Every visual decision of the panel is here: the C# side of Controls/ writes not a single
 * .style property, it only flips classes (R53/R120). Swatch colours come from the skin tokens
 * below, which is why a control can offer the skin primary without naming a colour in code.
 * ==========================================================================*/

.sb-ctlpanel {
    flex-grow: 1;
    flex-direction: column;
    min-height: 0;
}

.sb-ctlpanel__title {
    flex-shrink: 0;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    font-size: var(--sb-fs-12);
    color: var(--sb-ink);
    border-bottom-width: 1px;
    border-bottom-color: var(--sb-line);
}

.sb-ctlpanel__groups {
    flex-grow: 1;
    min-height: 0;
}

.sb-ctlpanel__group {
    padding-left: 12px;
    padding-right: 12px;
    padding-bottom: 6px;
}

.sb-ctlpanel__group-title {
    margin-top: 12px;
    margin-bottom: 2px;
    font-size: var(--sb-fs-10);
    letter-spacing: 1px;
    color: var(--sb-ink-disabled);
}

.sb-ctlpanel__empty {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding-left: 18px;
    padding-right: 18px;
}

.sb-ctlpanel__empty-title {
    font-size: var(--sb-fs-12);
    color: var(--sb-muted);
    margin-bottom: 6px;
}

.sb-ctlpanel__empty-text {
    font-size: var(--sb-fs-11);
    color: var(--sb-ink-disabled);
    white-space: normal;
    -unity-text-align: middle-center;
}

.sb-ctlpanel__foot {
    flex-shrink: 0;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-width: 1px;
    border-top-color: var(--sb-line);
    background-color: var(--sb-code);
}

.sb-ctlpanel__counters {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

/* Zone D -- reset to the story's seed (T-3406, rules T-3419). Appearance comes from the SECONDARY
   role at the end of the sheet; declared here is only the box: the control-height rung, so the
   button sits on the same baseline as every other control of the panel, and the horizontal
   padding a text button needs to stop reading as a label with a frame around it. */
.sb-ctlpanel__reset {
    height: var(--sb-h-ctl);
    margin: 0;
    padding-left: 10px;
    padding-right: 10px;
    font-size: var(--sb-fs-11);
}

.sb-ctlpanel__count {
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
}

.sb-ctlpanel__badge {
    font-size: var(--sb-fs-10);
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 6px;
    padding-right: 6px;
    border-radius: var(--sb-r-sm);
    color: var(--sb-ink);
}

.sb-ctlpanel__badge--ok {
    color: var(--sb-ok);
    background-color: var(--sb-accent-soft);
}

.sb-ctlpanel__badge--defect {
    color: var(--sb-bad);
    background-color: var(--sb-line-soft);
}

.sb-ctlpanel__hole {
    margin-top: 4px;
    font-size: var(--sb-fs-10);
    white-space: normal;
    color: var(--sb-muted);
}

.sb-ctlpanel__hole--dead {
    color: var(--sb-bad);
}

.sb-ctlpanel__hole--excluded {
    color: var(--sb-ink-disabled);
}

/* -- one row ------------------------------------------------------------- */

.sb-ctl {
    padding-top: 7px;
    padding-bottom: 7px;
    border-bottom-width: 1px;
    border-bottom-color: var(--sb-line);
}

.sb-ctl--inert {
    opacity: 0.45;
}

.sb-ctl__head {
    flex-direction: row;
    align-items: center;
}

.sb-ctl__name {
    font-size: var(--sb-fs-11);
    color: var(--sb-ink);
    margin-right: 6px;
}

.sb-ctl__badge {
    font-size: var(--sb-fs-10);
    padding-left: 4px;
    padding-right: 4px;
    margin-right: 4px;
    border-radius: var(--sb-r-sm);
    color: var(--sb-muted);
    background-color: var(--sb-code);
}

.sb-ctl__badge--dead {
    color: var(--sb-bad);
}

.sb-ctl__badge--manual {
    color: var(--sb-ink-disabled);
}

.sb-ctl__body {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.sb-ctl__note,
.sb-ctl__dependency {
    margin-top: 3px;
    font-size: var(--sb-fs-10);
    white-space: normal;
    color: var(--sb-ink-disabled);
}

/* -- bool ---------------------------------------------------------------- */

.sb-ctl__switch {
    width: var(--sb-switch-w);
    height: var(--sb-switch-h);
    padding: 0;
    margin: 0;
    border-radius: var(--sb-pill-switch);
    border-width: 1px;
    border-color: var(--sb-line);
    background-color: var(--sb-code);
    justify-content: center;
}

.sb-ctl__switch--on {
    background-color: var(--sb-accent);
    border-color: var(--sb-accent);
}

.sb-ctl__knob {
    width: var(--sb-knob);
    height: var(--sb-knob);
    margin-left: 2px;
    border-radius: var(--sb-pill-knob);
    background-color: var(--sb-bg);
}

.sb-ctl__switch--on .sb-ctl__knob {
    margin-left: 18px;
}

/* -- closed sets --------------------------------------------------------- */

.sb-ctl__segment {
    flex-grow: 1;
    flex-direction: row;
    padding: 2px;
    border-radius: var(--sb-r-sm);
    background-color: var(--sb-code);
}

.sb-ctl__seg {
    flex-grow: 1;
    margin: 0;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 2px;
    padding-right: 2px;
    font-size: var(--sb-fs-10);
    border-width: 0;
    border-radius: var(--sb-r-sm);
    background-color: rgba(0, 0, 0, 0);
    color: var(--sb-muted);
    text-overflow: ellipsis;
    overflow: hidden;
}

.sb-ctl__seg--active {
    background-color: var(--sb-panel);
    color: var(--sb-ink);
    border-width: 1px;
    border-color: var(--sb-line);
}

.sb-ctl__dropdown {
    flex-grow: 1;
    margin: 0;
    font-size: var(--sb-fs-11);
}

/* -- text, icon, numbers ------------------------------------------------- */

.sb-ctl__text,
.sb-ctl__number,
.sb-ctl__hex,
.sb-ctl__list-row {
    margin: 0;
    font-size: var(--sb-fs-11);
}

.sb-ctl__text {
    flex-grow: 1;
}

.sb-ctl__number {
    width: 52px;
    margin-left: 6px;
}

.sb-ctl__slider {
    flex-grow: 1;
    margin: 0;
}

.sb-ctl__glyph {
    width: 16px;
    height: 16px;
    margin-right: 6px;
}

/* -- colour -------------------------------------------------------------- */

.sb-ctl__swatches {
    flex-direction: row;
    align-items: center;
}

.sb-ctl__swatch {
    width: 18px;
    height: 18px;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 4px;
    padding: 0;
    border-radius: var(--sb-r-sm);
    border-width: 1px;
    border-color: var(--sb-line);
}

/* THE ONE DECLARED EXCEPTION to D2, and the reason it is an exception rather than an oversight.
 *
 * These six rules are the only place in this sheet that still reads the PRODUCT's palette, and
 * they must: the swatch is not chrome, it is a PREVIEW of the subject's own colour. The control
 * that owns them names no colour in C# at all — it reads back `resolvedStyle.backgroundColor` of
 * whichever swatch was clicked (SusControl.cs, the Color control), so a skin can change what the
 * palette offers with no code change. Repaint these from --sb-* and the swatch would show the
 * instrument's green while handing the story the product's green: a control that lies about the
 * value it is about to set.
 *
 * So the honest number for card T-3371 is 165 var(--sus-*) → 6, not → 0, and the six are here,
 * named, in one block. Whether a preview of the subject belongs in the shell's sheet at all, or
 * in a sheet of its own under the stage, is an architecture question and it is asked as a card,
 * not decided by a grep. */
.sb-ctl__swatch--primary {
    background-color: var(--sus-primary);
}

.sb-ctl__swatch--secondary {
    background-color: var(--sus-secondary);
}

.sb-ctl__swatch--neutral {
    background-color: var(--sus-text-secondary);
}

.sb-ctl__swatch--success {
    background-color: var(--sus-success);
}

.sb-ctl__swatch--error {
    background-color: var(--sus-error);
}

.sb-ctl__swatch--ink {
    background-color: var(--sus-text-primary);
}

.sb-ctl__hex {
    width: 84px;
    margin-left: 4px;
}

.sb-ctl__value {
    margin-left: 6px;
    font-size: var(--sb-fs-10);
    color: var(--sb-ink-disabled);
}

/* -- list and model ------------------------------------------------------ */

.sb-ctl__list-summary {
    margin: 0;
    padding-top: 3px;
    padding-bottom: 3px;
    padding-left: 8px;
    padding-right: 8px;
    font-size: var(--sb-fs-10);
    border-radius: var(--sb-r-sm);
    border-width: 1px;
    border-color: var(--sb-line);
    background-color: var(--sb-code);
    color: var(--sb-muted);
}

.sb-ctl__list {
    margin-top: 4px;
    padding-left: 8px;
    border-left-width: 1px;
    border-left-color: var(--sb-line);
}

.sb-ctl__list-row {
    margin-bottom: 3px;
}

.sb-ctl__list-add {
    margin: 0;
    padding-top: 2px;
    padding-bottom: 2px;
    font-size: var(--sb-fs-10);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sb-muted);
}

.sb-ctl__mono {
    flex-grow: 1;
    font-size: var(--sb-fs-10);
    color: var(--sb-muted);
    -unity-font-definition: var(--sb-font-mono);
}

/* -- icon picker (T-3035) ------------------------------------------------ */

.sb-ctl__iconfield {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    height: 30px;
    margin: 0;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-sm);
    background-color: var(--sb-code);
}

.sb-ctl__iconname {
    flex-grow: 1;
    font-size: var(--sb-fs-11);
    color: var(--sb-ink);
    -unity-font-definition: var(--sb-font-mono);
    -unity-text-align: middle-left;
}

.sb-ctl__iconname--empty {
    color: var(--sb-muted);
}

.sb-ctl__iconcaret {
    width: 12px;
    height: 12px;
    flex-shrink: 0;
}

.sb-iconpicker {
    width: 236px;
    padding: 8px;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-md);
    background-color: var(--sb-code);
}

.sb-iconpicker__search {
    flex-direction: row;
    align-items: center;
    height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-sm);
    background-color: var(--sb-code);
}

.sb-iconpicker__search-glyph {
    width: 13px;
    height: 13px;
    margin-right: 6px;
    flex-shrink: 0;
}

.sb-iconpicker__search-input {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    font-size: var(--sb-fs-12);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sb-ink);
}

.sb-iconpicker__search-input > #unity-text-input {
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sb-ink);
}

.sb-iconpicker__placeholder {
    position: absolute;
    left: 27px;
    font-size: var(--sb-fs-12);
    color: var(--sb-muted);
}

.sb-iconpicker__placeholder.sb-hidden {
    display: none;
}

.sb-iconpicker__none {
    margin: 0;
    margin-top: 6px;
    padding-top: 3px;
    padding-bottom: 3px;
    font-size: var(--sb-fs-11);
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sb-muted);
    -unity-font-definition: var(--sb-font-mono);
    -unity-text-align: middle-left;
}

.sb-iconpicker__scroll {
    max-height: 176px;
    margin-top: 6px;
}

.sb-iconpicker__scroll.sb-hidden {
    display: none;
}

.sb-iconpicker__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.sb-iconpicker__cell {
    width: 34px;
    height: 34px;
    margin: 1px;
    padding: 0;
    align-items: center;
    justify-content: center;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: var(--sb-r-sm);
    background-color: rgba(0, 0, 0, 0);
}

.sb-iconpicker__cell:hover {
    background-color: var(--sb-line-soft);
}

.sb-iconpicker__cell--selected {
    border-color: var(--sb-accent);
    background-color: var(--sb-accent-soft);
}

.sb-iconpicker__cell-glyph {
    width: 18px;
    height: 18px;
}

.sb-iconpicker__empty {
    margin-top: 10px;
    margin-bottom: 4px;
    padding-left: 4px;
    padding-right: 4px;
    font-size: var(--sb-fs-12);
    color: var(--sb-muted);
    white-space: normal;
}

.sb-iconpicker__empty.sb-hidden {
    display: none;
}

.sb-iconpicker__foot {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
}

.sb-iconpicker__count,
.sb-iconpicker__hint {
    font-size: var(--sb-fs-11);
    color: var(--sb-muted);
    -unity-font-definition: var(--sb-font-mono);
}

.sb-iconpicker__hint.sb-hidden {
    display: none;
}

/* == Unity's own elements: the parts that had no declared appearance ==========
 *
 * Card T-3354, plan ARCH-20260911-STORYBOOK-SHELL.md 4.4, decisions D11 / D12 / D13 / D14.
 *
 * The shell keeps Unity's built-in ScrollView, TextField, DropdownField, Slider and Button --
 * kit is out of reach here (sus-core cannot depend on a paid package, R25, and D2 forbids
 * wearing the subject's clothes anyway), and rewriting scrolling, focus, keyboard and IME in
 * core would be weeks, not a wave. What was missing was not the structure but the SKIN: before
 * this card the sheet contained exactly ZERO `.unity-*` selectors, so 6 of 7 text inputs showed
 * Unity's light-grey default on a dark shell, and every scroll band was 24px wide with two pale
 * arrow buttons on it. That is the whole of "the scrollbars are huge" and "the inputs are
 * colourless".
 *
 * WHY THE SELECTORS LOOK LIKE THIS. Every rule is anchored on a shell class and reaches inward
 * with `>` before it uses a descendant step (D20): the canvas holds the SUBJECT of inspection,
 * and a rule like `.sb-shell .unity-scroller` would also repaint a ScrollView that belongs to the
 * component being judged. Anchoring on the six named shell ScrollViews and the seven named shell
 * fields keeps the rule inside the instrument. Inside a scroller or a field there is never a
 * story, so a descendant step below that anchor is safe and survives Unity moving a part one
 * level up or down between versions.
 */

/* -- ScrollView: an 8px band, no arrows (D12) -------------------------------
 *
 * WHY EVERY BAND IS NAMED TWICE. ScrollView.verticalScroller is NOT a child of the ScrollView.
 * Measured on this editor (Unity 6000.3.17f1, 2026-09-11, card T-3399): the vertical scroller
 * sits inside unity-content-and-vertical-scroll-container, one level further down, while the
 * horizontal scroller IS a direct child. The first cut of this section used only ">", so it
 * skinned all six horizontal bands and left all six vertical ones at Unity default: a 24px band
 * with two arrow buttons, which is precisely the band a reader sees over zone A.
 *
 * Stepping through that container does NOT widen the reach (D20): the class is a ScrollView part
 * and never a story boundary, so a selector anchored on a shell ScrollView still cannot leave
 * that ScrollView. The direct-child form is kept beside it so a Unity version that flattens the
 * hierarchy back is skinned by the same rules instead of silently reverting to 24px.
 */

.sb-nav__list > .unity-scroller,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller,
.sb-stage > .unity-scroller,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller,
.sb-env__chips > .unity-scroller,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller,
.sb-matrix__scroll > .unity-scroller,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller,
.sb-ctlpanel__groups > .unity-scroller,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller,
.sb-iconpicker__scroll > .unity-scroller,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller {
    /* Unity default is a 24px band with a button at each end. The mock-up has an 8px band and
       no buttons at all. */
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
}

.sb-nav__list > .unity-scroller--vertical,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical,
.sb-stage > .unity-scroller--vertical,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical,
.sb-env__chips > .unity-scroller--vertical,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical,
.sb-matrix__scroll > .unity-scroller--vertical,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical,
.sb-ctlpanel__groups > .unity-scroller--vertical,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical,
.sb-iconpicker__scroll > .unity-scroller--vertical,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical {
    width: var(--sb-scrollbar);
    min-width: var(--sb-scrollbar);
}

.sb-nav__list > .unity-scroller--horizontal,
.sb-stage > .unity-scroller--horizontal,
.sb-env__chips > .unity-scroller--horizontal,
.sb-matrix__scroll > .unity-scroller--horizontal,
.sb-ctlpanel__groups > .unity-scroller--horizontal,
.sb-iconpicker__scroll > .unity-scroller--horizontal {
    /* No container form here: the horizontal scroller is a direct child of the ScrollView on
       every Unity version measured. */
    height: var(--sb-scrollbar);
    min-height: var(--sb-scrollbar);
}

.sb-nav__list > .unity-scroller .unity-scroller__low-button,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__low-button,
.sb-stage > .unity-scroller .unity-scroller__low-button,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__low-button,
.sb-env__chips > .unity-scroller .unity-scroller__low-button,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__low-button,
.sb-matrix__scroll > .unity-scroller .unity-scroller__low-button,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__low-button,
.sb-ctlpanel__groups > .unity-scroller .unity-scroller__low-button,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__low-button,
.sb-iconpicker__scroll > .unity-scroller .unity-scroller__low-button,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__low-button,
.sb-nav__list > .unity-scroller .unity-scroller__high-button,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__high-button,
.sb-stage > .unity-scroller .unity-scroller__high-button,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__high-button,
.sb-env__chips > .unity-scroller .unity-scroller__high-button,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__high-button,
.sb-matrix__scroll > .unity-scroller .unity-scroller__high-button,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__high-button,
.sb-ctlpanel__groups > .unity-scroller .unity-scroller__high-button,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__high-button,
.sb-iconpicker__scroll > .unity-scroller .unity-scroller__high-button,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__high-button {
    /* The two pale squares at the ends of every band. The mock-up has none, and a drag band this
       thin has no room for a hit target anyway. */
    display: none;
}

.sb-nav__list > .unity-scroller .unity-scroller__slider,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__slider,
.sb-stage > .unity-scroller .unity-scroller__slider,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__slider,
.sb-env__chips > .unity-scroller .unity-scroller__slider,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__slider,
.sb-matrix__scroll > .unity-scroller .unity-scroller__slider,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__slider,
.sb-ctlpanel__groups > .unity-scroller .unity-scroller__slider,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__slider,
.sb-iconpicker__scroll > .unity-scroller .unity-scroller__slider,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-scroller__slider {
    margin: 0;
    min-width: var(--sb-scrollbar);
    min-height: var(--sb-scrollbar);
}

.sb-nav__list > .unity-scroller .unity-base-slider__tracker,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__tracker,
.sb-stage > .unity-scroller .unity-base-slider__tracker,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__tracker,
.sb-env__chips > .unity-scroller .unity-base-slider__tracker,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__tracker,
.sb-matrix__scroll > .unity-scroller .unity-base-slider__tracker,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__tracker,
.sb-ctlpanel__groups > .unity-scroller .unity-base-slider__tracker,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__tracker,
.sb-iconpicker__scroll > .unity-scroller .unity-base-slider__tracker,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
}

/* T-3354 RETURN: the band container above is 8px (--sb-scrollbar), but the tracker/dragger
 * INSIDE a Unity BaseSlider carry their own cross-axis size from Unity's default control style
 * (measured 24px tracker / 18px dragger, left offset 3px) — a size the 8px band never
 * constrained, because tracker/dragger are the slider's absolute-positioned children, not a
 * percentage of the parent box. Left unset, the dragger just overflows the band (measured 18px
 * wide crossing 6px into the next zone on kit-shell-1440 nav). Cross-axis width/height is fixed
 * here explicitly, per orientation, same as the band itself two rules up; the scroll-axis size
 * (how tall/wide the dragger is along the direction you drag) stays Unity's own, set from the
 * content ratio, and is untouched. */
.sb-nav__list > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-stage > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-env__chips > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-matrix__scroll > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-ctlpanel__groups > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-iconpicker__scroll > .unity-scroller--vertical .unity-base-slider__tracker,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__tracker {
    width: var(--sb-scrollbar);
    left: 0;
}

.sb-nav__list > .unity-scroller--horizontal .unity-base-slider__tracker,
.sb-stage > .unity-scroller--horizontal .unity-base-slider__tracker,
.sb-env__chips > .unity-scroller--horizontal .unity-base-slider__tracker,
.sb-matrix__scroll > .unity-scroller--horizontal .unity-base-slider__tracker,
.sb-ctlpanel__groups > .unity-scroller--horizontal .unity-base-slider__tracker,
.sb-iconpicker__scroll > .unity-scroller--horizontal .unity-base-slider__tracker {
    height: var(--sb-scrollbar);
    top: 0;
}

.sb-nav__list > .unity-scroller .unity-base-slider__dragger,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger,
.sb-stage > .unity-scroller .unity-base-slider__dragger,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger,
.sb-env__chips > .unity-scroller .unity-base-slider__dragger,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger,
.sb-matrix__scroll > .unity-scroller .unity-base-slider__dragger,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger,
.sb-ctlpanel__groups > .unity-scroller .unity-base-slider__dragger,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger,
.sb-iconpicker__scroll > .unity-scroller .unity-base-slider__dragger,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger {
    background-color: var(--sb-line);
    border-width: 0;
    border-radius: var(--sb-r-sm);
    margin: 0;
}

/* T-3354 RETURN: same cross-axis fix as the tracker above, for the dragger itself — this is the
 * part actually measured 18px wide on the returned frames. */
.sb-nav__list > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-stage > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-env__chips > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-matrix__scroll > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-ctlpanel__groups > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-iconpicker__scroll > .unity-scroller--vertical .unity-base-slider__dragger,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller--vertical .unity-base-slider__dragger {
    width: var(--sb-scrollbar);
    left: 0;
}

.sb-nav__list > .unity-scroller--horizontal .unity-base-slider__dragger,
.sb-stage > .unity-scroller--horizontal .unity-base-slider__dragger,
.sb-env__chips > .unity-scroller--horizontal .unity-base-slider__dragger,
.sb-matrix__scroll > .unity-scroller--horizontal .unity-base-slider__dragger,
.sb-ctlpanel__groups > .unity-scroller--horizontal .unity-base-slider__dragger,
.sb-iconpicker__scroll > .unity-scroller--horizontal .unity-base-slider__dragger {
    height: var(--sb-scrollbar);
    top: 0;
}

.sb-nav__list > .unity-scroller .unity-base-slider__dragger:hover,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger:hover,
.sb-stage > .unity-scroller .unity-base-slider__dragger:hover,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger:hover,
.sb-env__chips > .unity-scroller .unity-base-slider__dragger:hover,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger:hover,
.sb-matrix__scroll > .unity-scroller .unity-base-slider__dragger:hover,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger:hover,
.sb-ctlpanel__groups > .unity-scroller .unity-base-slider__dragger:hover,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger:hover,
.sb-iconpicker__scroll > .unity-scroller .unity-base-slider__dragger:hover,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger:hover {
    background-color: var(--sb-muted);
}

.sb-nav__list > .unity-scroller .unity-base-slider__dragger-border,
.sb-nav__list > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger-border,
.sb-stage > .unity-scroller .unity-base-slider__dragger-border,
.sb-stage > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger-border,
.sb-env__chips > .unity-scroller .unity-base-slider__dragger-border,
.sb-env__chips > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger-border,
.sb-matrix__scroll > .unity-scroller .unity-base-slider__dragger-border,
.sb-matrix__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger-border,
.sb-ctlpanel__groups > .unity-scroller .unity-base-slider__dragger-border,
.sb-ctlpanel__groups > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger-border,
.sb-iconpicker__scroll > .unity-scroller .unity-base-slider__dragger-border,
.sb-iconpicker__scroll > .unity-scroll-view__content-and-vertical-scroll-container > .unity-scroller .unity-base-slider__dragger-border {
    display: none;
}


/* -- Shell text colour is DECLARED, never borrowed (D27, card T-3400) --------
 *
 * Measured 2026-09-11 (sus-dev, Play, resolvedStyle of 541 shell elements outside the stage
 * canvas, before and after ONE flip of the stage theme chip): background changed on 0 of them and
 * geometry on 0, but COLOUR changed on 107 — .sb-nav__row-name x95, .sb-ctl__text x5,
 * .sb-ctl__switch x3, .sb-ctl__knob x3, .sb-env__share-label x1. Two of the four chip
 * combinations were unreadable as a result: a story name at 0.059 on a 0.122 nav, and at 0.941 on
 * a 0.984 one.
 *
 * color is the one INHERITED property this sheet uses, and these five classes never declared it
 * — so their value came from whatever rule outside the shell happened to match them, and that
 * value is a function of a theme class the shell does not own. Declaring the colour from the
 * shell's own --sb-* set closes the path by itself, and closes it for every cascade above, not just
 * for the one axis that was measured (R138: the shell and the subject exchange no tokens).
 *
 * The nav name is declared through its ROW on purpose: a bare .sb-nav__row-name { color }
 * would out-specify the accent that --active passes down by inheritance, and the selected row
 * would lose its highlight.
 */

.sb-nav__row > .sb-nav__row-name {
    color: var(--sb-ink);
}

.sb-nav__row--active > .sb-nav__row-name {
    color: var(--sb-accent-text);
}

.sb-env__share > .sb-env__share-label {
    color: var(--sb-ink);
}

.sb-ctl__text,
.sb-ctl__number,
.sb-ctl__hex,
.sb-ctl__mono,
.sb-ctl__list-row,
.sb-ctl__switch,
.sb-ctl__knob {
    color: var(--sb-ink);
}

/* -- ...and so is the FACE (D5, card T-3357) --------------------------------
 *
 * Same mechanism as the colour above, same measured cause, and it has to be said separately
 * because -unity-font-definition is the second inherited property in play. Measured in Play
 * 2026-09-11 right after the family swap: 142 shell text elements resolved as
 * InstrumentSans-Regular 29, GeistMono-Regular 36, InstrumentSans-SemiBold 8 — and
 * Montserrat-Medium 69, i.e. still the PRODUCT face. The ancestor chain was Instrument the
 * whole way down (shell root, body, nav, its ScrollView) and flipped on the Button itself, which
 * is the signature of a rule MATCHING the element rather than a cascade problem.
 *
 * The rule lives in a component-library sheet layered over this package, not here: an
 * UNANCHORED selector list (it ends at .unity-progress-bar__progress) that names
 * .unity-text-element and .unity-button__label,
 * which EVERY Button and Label carries whoever built it, and declares both
 * -unity-font-definition: var(--sk-font-family-label) and color: var(--sk-color-text-primary).
 * A declaration always beats an inherited value, so the shell's root face never reached any
 * shell element that did not declare its own — and re-typing the product would re-type the
 * instrument, which is exactly what D5 forbids.
 *
 * Hence: every text-bearing shell class that had no face of its own now declares one, and none
 * of these selectors can leave the shell. Anchoring on .sb-shell and sweeping .unity-text-element
 * from above was the tempting one-liner and is refused: it would reach INTO the stage canvas and
 * re-type the subject on display, the same trespass in the other direction (D2, D27).
 *
 * 500 and not 400: that is the weight the product rule was handing these buttons
 * (--sk-font-family-label resolves to the Medium face), so the family changes and the weight
 * does not. The nav name is declared through its ROW for the same reason as its colour — and
 * --active needs its own line, or the selected row would lose the 600 face it asks for.
 */

.sb-nav__row,
.sb-nav__row > .sb-nav__row-name,
.sb-nav__tab,
.sb-env__share > .sb-env__share-label,
.sb-btn--accent,
.sb-btn--secondary,
.sb-btn--ghost,
.sb-shell__burger,
.sb-shell__share,
.sb-env__share,
.sb-env__props,
.sb-ctl__list-add,
.sb-ctl__iconfield {
    -unity-font-definition: var(--sb-fw-500);
}

.sb-nav__row--active > .sb-nav__row-name {
    -unity-font-definition: var(--sb-fw-600);
}

/* The text INSIDE a shell TextField is a THIRD element, below the field and below
   #unity-text-input, and the product rule names it too (.unity-text-element on the inner input
   component — 3 of them measured still on the product face after the swap above). The list is
   the same one the state block below uses for #unity-text-input, so the two never drift apart;
   every entry is anchored on the field's own shell class, so no selector here can reach a
   TextField of the subject on display. */
.sb-nav__search-input .unity-text-element,
.sb-iconpicker__search-input .unity-text-element,
.sb-ctl__text .unity-text-element,
.sb-ctl__number .unity-text-element,
.sb-ctl__hex .unity-text-element,
.sb-ctl__list-row .unity-text-element {
    -unity-font-definition: var(--sb-font-ui);
}

.sb-ctl__mono .unity-text-element {
    -unity-font-definition: var(--sb-font-mono);
}

/* -- TextField: five states, three properties each (D13) ----------------------
 *
 * rest / hover / focus / disabled / invalid, and each one says background, border and text.
 * Declaring only the resting state is how "the inputs are colourless" comes back one wave later
 * as "you cannot tell what has focus". `--invalid` has no producer in the engine yet -- the
 * contract is declared here so a producer has something to switch on, and so the next reader can
 * see which of the five states is still waiting for code instead of guessing.
 */

.sb-nav__search-input > #unity-text-input,
.sb-iconpicker__search-input > #unity-text-input,
.sb-ctl__text > #unity-text-input,
.sb-ctl__number > #unity-text-input,
.sb-ctl__hex > #unity-text-input,
.sb-ctl__mono > #unity-text-input,
.sb-ctl__list-row > #unity-text-input {
    background-color: var(--sb-code);
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-sm);
    color: var(--sb-ink);
    -unity-font-definition: var(--sb-font-ui);
    font-size: var(--sb-fs-12);
}

.sb-nav__search-input:hover > #unity-text-input,
.sb-iconpicker__search-input:hover > #unity-text-input,
.sb-ctl__text:hover > #unity-text-input,
.sb-ctl__number:hover > #unity-text-input,
.sb-ctl__hex:hover > #unity-text-input,
.sb-ctl__mono:hover > #unity-text-input,
.sb-ctl__list-row:hover > #unity-text-input {
    border-color: var(--sb-muted);
}

.sb-nav__search-input:focus > #unity-text-input,
.sb-iconpicker__search-input:focus > #unity-text-input,
.sb-ctl__text:focus > #unity-text-input,
.sb-ctl__number:focus > #unity-text-input,
.sb-ctl__hex:focus > #unity-text-input,
.sb-ctl__mono:focus > #unity-text-input,
.sb-ctl__list-row:focus > #unity-text-input,
.sb-nav__search-input > #unity-text-input:focus,
.sb-iconpicker__search-input > #unity-text-input:focus,
.sb-ctl__text > #unity-text-input:focus,
.sb-ctl__number > #unity-text-input:focus,
.sb-ctl__hex > #unity-text-input:focus,
.sb-ctl__mono > #unity-text-input:focus,
.sb-ctl__list-row > #unity-text-input:focus {
    border-color: var(--sb-accent);
    background-color: var(--sb-panel);
    color: var(--sb-ink);
}

.sb-nav__search-input:disabled > #unity-text-input,
.sb-iconpicker__search-input:disabled > #unity-text-input,
.sb-ctl__text:disabled > #unity-text-input,
.sb-ctl__number:disabled > #unity-text-input,
.sb-ctl__hex:disabled > #unity-text-input,
.sb-ctl__mono:disabled > #unity-text-input,
.sb-ctl__list-row:disabled > #unity-text-input {
    background-color: var(--sb-line-soft);
    border-color: var(--sb-line);
    color: var(--sb-ink-disabled);
}

.sb-nav__search-input--invalid > #unity-text-input,
.sb-iconpicker__search-input--invalid > #unity-text-input,
.sb-ctl__text--invalid > #unity-text-input,
.sb-ctl__number--invalid > #unity-text-input,
.sb-ctl__hex--invalid > #unity-text-input,
.sb-ctl__mono--invalid > #unity-text-input,
.sb-ctl__list-row--invalid > #unity-text-input {
    background-color: var(--sb-code);
    border-color: var(--sb-bad);
    color: var(--sb-bad);
}

/* The two search boxes draw their own frame, so their field stays frameless inside it. This was
 * the ONE `.unity-*` override the sheet already had before T-3354; it is kept, and now stated as
 * a deliberate exception rather than standing there as the only field anybody remembered to
 * dress. */
.sb-nav__search-input > #unity-text-input,
.sb-nav__search-input:hover > #unity-text-input,
.sb-nav__search-input:focus > #unity-text-input,
.sb-iconpicker__search-input > #unity-text-input,
.sb-iconpicker__search-input:hover > #unity-text-input,
.sb-iconpicker__search-input:focus > #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding-left: 0;
    padding-right: 0;
    color: var(--sb-ink);
}

/* -- DropdownField: field, text, arrow (4.4) -------------------------------- */

.sb-ctl__dropdown .unity-base-popup-field__input {
    background-color: var(--sb-code);
    border-width: 1px;
    border-color: var(--sb-line);
    border-radius: var(--sb-r-sm);
}

.sb-ctl__dropdown:hover .unity-base-popup-field__input {
    border-color: var(--sb-muted);
}

.sb-ctl__dropdown:focus .unity-base-popup-field__input {
    border-color: var(--sb-accent);
}

.sb-ctl__dropdown:disabled .unity-base-popup-field__input {
    background-color: var(--sb-line-soft);
    border-color: var(--sb-line);
}

.sb-ctl__dropdown .unity-base-popup-field__text {
    color: var(--sb-ink);
    -unity-font-definition: var(--sb-font-ui);
    font-size: var(--sb-fs-12);
}

.sb-ctl__dropdown:disabled .unity-base-popup-field__text {
    color: var(--sb-ink-disabled);
}

.sb-ctl__dropdown .unity-base-popup-field__arrow {
    -unity-background-image-tint-color: var(--sb-muted);
}

/* The dropped-open list is NOT reachable from this sheet: UI Toolkit renders it in the panel's
 * own root overlay, outside the shell subtree, so no selector anchored on a shell class can
 * touch it. Named here so the gap reads as a measured boundary and not as a missing row of the
 * 4.4 table; dressing it needs the list's own sheet, which is a separate card. */

/* -- Slider: tracker, dragger, the number field beside it (4.4) ------------- */

.sb-ctl__slider .unity-base-slider__tracker {
    background-color: var(--sb-line);
    border-width: 0;
    border-radius: var(--sb-r-xs);
    height: 4px;
}

.sb-ctl__slider .unity-base-slider__dragger {
    background-color: var(--sb-accent);
    border-width: 0;
    border-radius: var(--sb-pill-knob);
    width: var(--sb-knob);
    height: var(--sb-knob);
}

.sb-ctl__slider:hover .unity-base-slider__dragger {
    background-color: var(--sb-ink);
}

.sb-ctl__slider:disabled .unity-base-slider__tracker {
    background-color: var(--sb-line-soft);
}

.sb-ctl__slider:disabled .unity-base-slider__dragger {
    background-color: var(--sb-ink-disabled);
}

.sb-ctl__slider .unity-base-slider__dragger-border {
    display: none;
}

/* -- Button: three roles, four states each (D14) ------------------------------
 *
 * The mock-up separates chrome buttons by weight -- accent on "share", ghost on the icon-only
 * ones -- and one appearance across all seventeen is precisely what "the buttons are not styled"
 * means. The role classes below are the vocabulary; the shell's existing button classes are
 * grouped onto a role beside them, so the roles are real today without re-tagging the C# that
 * builds those buttons. This block sits at the end of the sheet on purpose: at equal specificity
 * the later rule wins, so a role lands on top of whatever an earlier section set.
 */

/* role 1 -- accent: the one action a reader is meant to find */
.sb-btn--accent,
.sb-shell__share,
.sb-env__share {
    height: var(--sb-h-ctl);
    border-width: 1px;
    border-radius: var(--sb-r-sm);
    border-color: var(--sb-accent);
    background-color: var(--sb-accent);
    color: var(--sb-accent-ink);
    font-size: var(--sb-fs-12);
}

.sb-btn--accent:hover,
.sb-shell__share:hover,
.sb-env__share:hover {
    border-color: var(--sb-ink);
    background-color: var(--sb-ink);
    color: var(--sb-bg);
}

.sb-btn--accent:active,
.sb-shell__share:active,
.sb-env__share:active {
    border-color: var(--sb-accent);
    background-color: var(--sb-accent-soft);
    color: var(--sb-accent);
}

.sb-btn--accent:disabled,
.sb-shell__share:disabled,
.sb-env__share:disabled {
    border-color: var(--sb-line);
    background-color: var(--sb-line-soft);
    color: var(--sb-ink-disabled);
}

/* role 2 -- secondary: a framed button that is not the main action */
.sb-btn--secondary,
.sb-shell__burger,
.sb-ctl__list-add,
.sb-ctl__iconfield {
    border-width: 1px;
    border-radius: var(--sb-r-sm);
    border-color: var(--sb-line);
    background-color: var(--sb-code);
    color: var(--sb-ink);
}

.sb-btn--secondary:hover,
.sb-shell__burger:hover,
.sb-ctl__list-add:hover,
.sb-ctl__iconfield:hover {
    border-color: var(--sb-muted);
    background-color: var(--sb-line-soft);
}

.sb-btn--secondary:active,
.sb-shell__burger:active,
.sb-ctl__list-add:active,
.sb-ctl__iconfield:active {
    border-color: var(--sb-accent);
    background-color: var(--sb-accent-soft);
    color: var(--sb-accent);
}

.sb-btn--secondary:disabled,
.sb-shell__burger:disabled,
.sb-ctl__list-add:disabled,
.sb-ctl__iconfield:disabled {
    border-color: var(--sb-line);
    background-color: rgba(0, 0, 0, 0);
    color: var(--sb-ink-disabled);
}

/* role 3 -- ghost: frameless, reads as text until pointed at */
.sb-btn--ghost,
.sb-nav__tab,
.sb-matrix__toggle,
.sb-ctl__list-summary {
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--sb-muted);
}

.sb-btn--ghost:hover,
.sb-matrix__toggle:hover,
.sb-ctl__list-summary:hover {
    background-color: var(--sb-line-soft);
    color: var(--sb-ink);
}

.sb-btn--ghost:active,
.sb-matrix__toggle:active,
.sb-ctl__list-summary:active {
    background-color: var(--sb-accent-soft);
    color: var(--sb-accent);
}

.sb-btn--ghost:disabled,
.sb-nav__tab:disabled,
.sb-matrix__toggle:disabled,
.sb-ctl__list-summary:disabled {
    background-color: rgba(0, 0, 0, 0);
    color: var(--sb-ink-disabled);
}

/* The nav tab is a ghost button that ALSO has to show which of the two lists is open, and the
 * underline is that signal -- restated after the ghost role so the role does not quietly erase
 * it. */
.sb-nav__tab {
    border-bottom-width: 2px;
    border-bottom-color: rgba(0, 0, 0, 0);
}

.sb-nav__tab:hover {
    color: var(--sb-ink);
    background-color: rgba(0, 0, 0, 0);
}

.sb-nav__tab--active {
    color: var(--sb-ink);
    border-bottom-color: var(--sb-accent);
}

/* -- zone B: the entry into zone D on a narrow shell (T-3377, D25) ---------- */

.sb-env__props {
    height: 24px;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    display: none;
    margin-left: 8px;
    padding-left: 8px;
    padding-right: 8px;
    border-width: 1px;
    border-radius: var(--sb-r-sm);
    border-color: var(--sb-line);
    background-color: var(--sb-code);
    color: var(--sb-ink);
    font-size: var(--sb-fs-11);
}

.sb-shell--narrow .sb-env__props {
    display: flex;
}

.sb-env__props:hover {
    border-color: var(--sb-muted);
    background-color: var(--sb-line-soft);
}

.sb-shell--panel-open .sb-env__props {
    border-color: var(--sb-accent);
    background-color: var(--sb-accent-soft);
    color: var(--sb-accent);
}
